{
  "schema_version": 1,
  "defaults": {
    "user": "llmops",
    "port": 22,
    "install_root": "~/.local/llm-ops",
    "ssh_key": "~/.ssh/llmops_deploy_ed25519",
    "config_profile": "default"
  },
  "hosts": [
    {
      "name": "llm-primary",
      "role": "llm",
      "host": "llm-primary.example.net",
      "tags": ["production", "model"]
    },
    {
      "name": "agent-primary",
      "role": "agent",
      "host": "agent-primary.example.net",
      "tags": ["production", "agent"]
    },
    {
      "name": "hybrid-dev",
      "role": "hybrid",
      "host": "hybrid-dev.example.net",
      "user": "miafour",
      "proxy_jump": "deploy@bastion.example.net",
      "install_root": "~/.local/llm-ops",
      "config_profile": "dev",
      "tags": ["development"]
    }
  ]
}
