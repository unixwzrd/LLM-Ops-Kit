{
  "schema_version": 1,
  "defaults": {
    "user": "operator",
    "port": 22,
    "install_root": "~/.local/llm-ops",
    "config_profile": "default",
    "ssh_key": "~/.ssh/id_ed25519_llmops"
  },
  "hosts": [
    {
      "name": "model-host",
      "role": "llm",
      "host": "model-host.local"
    },
    {
      "name": "agent-host",
      "role": "agent",
      "host": "agent-host.local"
    }
  ]
}
