{
  "template_version": 1,
  "id": "ssh-tunnel",
  "version": "1.2.0",
  "adapter": "ssh-tunnel",
  "profile_kind": "service",
  "component_kind": "tunnel",
  "platforms": ["darwin"],
  "lifecycle": "ssh-tunnel",
  "profile_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": true, "required": ["schema_version", "name", "label"], "properties": {"schema_version": {"type": "integer", "const": 2, "default": 2}, "template_id": {"type": "string", "const": "ssh-tunnel", "default": "ssh-tunnel"}, "name": {"type": "string", "minLength": 1, "x-llmops-ui": {"group": "Identity", "order": 10}}, "label": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "x-llmops-ui": {"group": "LaunchAgent", "order": 10}}, "plist": {"type": "string", "minLength": 1, "x-llmops-ui": {"group": "LaunchAgent", "order": 20, "widget": "path"}}, "log_path": {"type": "string", "x-llmops-ui": {"group": "Logging", "order": 10, "widget": "path"}}}},
  "defaults": {"schema_version": 2, "template_id": "ssh-tunnel", "name": "tunnel", "label": "org.example.ssh-tunnel"},
  "bindings": {"resolver": "launchd-external"},
  "endpoints": {},
  "logs": {"service": {"path_field": "log_path"}},
  "actions": {}
}
