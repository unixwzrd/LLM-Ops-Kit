{
  "template_version": 1,
  "id": "launchd-user",
  "version": "1.0.0",
  "adapter": "launchd",
  "profile_kind": "service",
  "component_kind": "service",
  "platforms": ["darwin"],
  "lifecycle": "launchd-user",
  "profile_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true,
    "required": ["schema_version", "name", "label", "program_arguments"],
    "properties": {
      "schema_version": {"type": "integer", "const": 2, "default": 2},
      "template_id": {"type": "string", "const": "launchd-user", "default": "launchd-user"},
      "name": {"type": "string", "minLength": 1},
      "label": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "x-llmops-ui": {"group": "LaunchAgent", "order": 10}},
      "program_arguments": {"type": "array", "minItems": 1, "items": {"type": "string"}, "x-llmops-ui": {"group": "LaunchAgent", "order": 20, "widget": "argv"}},
      "working_directory": {"type": "string", "x-llmops-ui": {"group": "LaunchAgent", "order": 30, "widget": "path"}},
      "run_at_load": {"type": "boolean", "default": false, "x-llmops-ui": {"group": "Lifecycle", "order": 10, "widget": "checkbox"}},
      "keep_alive": {"type": "boolean", "default": false, "x-llmops-ui": {"group": "Lifecycle", "order": 20, "widget": "checkbox"}},
      "environment": {"type": "object", "additionalProperties": {"type": "string"}, "default": {}},
      "stdout": {"type": "string", "x-llmops-ui": {"group": "Logging", "order": 10, "widget": "path"}},
      "stderr": {"type": "string", "x-llmops-ui": {"group": "Logging", "order": 20, "widget": "path"}}
    }
  },
  "defaults": {"schema_version": 2, "template_id": "launchd-user", "name": "service", "label": "org.example.service", "program_arguments": ["/usr/bin/true"], "run_at_load": false, "keep_alive": false, "environment": {}},
  "bindings": {"resolver": "launchd-user"},
  "endpoints": {},
  "logs": {"stdout": {"path_field": "stdout"}, "stderr": {"path_field": "stderr"}},
  "actions": {}
}
