  "profile_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": true, "required": ["schema_version", "name", "url"], "properties": {"schema_version": {"type": "integer", "const": 2, "default": 2}, "template_id": {"type": "string", "const": "external-http", "default": "external-http"}, "name": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri", "x-llmops-ui": {"group": "Endpoint", "order": 10}}, "health_path": {"type": "string", "default": "/health", "x-llmops-ui": {"group": "Endpoint", "order": 20}}}},
  "defaults": {"schema_version": 2, "template_id": "external-http", "name": "external-service", "url": "http://127.0.0.1:8080", "health_path": "/health"},
  "bindings": {"resolver": "external"},
