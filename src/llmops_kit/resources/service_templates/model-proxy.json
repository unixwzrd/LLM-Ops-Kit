{
  "template_version": 1,
  "id": "model-proxy",
  "version": "1.0.0",
  "adapter": "model-proxy",
  "profile_kind": "service",
  "component_kind": "proxy",
  "platforms": ["darwin", "linux"],
  "lifecycle": "standalone",
  "profile_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true,
    "required": ["schema_version", "name", "runtime"],
    "properties": {
      "schema_version": {"type": "integer", "const": 2, "default": 2},
      "template_id": {"type": "string", "const": "model-proxy", "default": "model-proxy"},
      "name": {"type": "string", "minLength": 1, "x-llmops-ui": {"group": "Identity", "order": 10}},
      "runtime": {"type": "object", "required": ["listen_host", "listen_port", "upstream_host", "upstream_port"], "properties": {
        "python_bin": {"type": "string", "x-llmops-ui": {"group": "Runtime", "order": 10, "widget": "path"}},
        "listen_host": {"type": "string", "default": "127.0.0.1", "x-llmops-ui": {"group": "Listener", "order": 10}},
        "listen_port": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 11434, "x-llmops-ui": {"group": "Listener", "order": 20, "widget": "number"}},
        "upstream_host": {"type": "string", "default": "127.0.0.1", "x-llmops-ui": {"group": "Upstream", "order": 10}},
        "upstream_port": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 11434, "x-llmops-ui": {"group": "Upstream", "order": 20, "widget": "number"}}
      }},
      "template": {"type": "object", "properties": {"path": {"type": "string", "x-llmops-ui": {"group": "Prompt", "order": 10, "widget": "path"}}}},
      "logging": {"type": "object", "properties": {
        "rotate_seconds": {"type": "integer", "minimum": 60, "default": 86400, "x-llmops-ui": {"group": "Logging", "order": 10, "widget": "duration"}},
        "rotate_keep": {"type": "integer", "minimum": 1, "default": 5, "x-llmops-ui": {"group": "Logging", "order": 20, "widget": "number"}}
      }}
    }
  },
  "defaults": {"schema_version": 2, "template_id": "model-proxy", "name": "model-proxy", "runtime": {"listen_host": "127.0.0.1", "listen_port": 11434, "upstream_host": "127.0.0.1", "upstream_port": 11434}, "logging": {"rotate_seconds": 86400, "rotate_keep": 5}},
  "bindings": {"resolver": "model-proxy"},
  "endpoints": {"provides": {"openai": {"scheme": "http", "host_path": "runtime.listen_host", "port_path": "runtime.listen_port"}}, "requires": {"upstream": {"protocol": "openai", "host_path": "runtime.upstream_host", "port_path": "runtime.upstream_port", "lifecycle_dependency": true}}},
  "logs": {"service": {}, "raw-request": {}, "rendered-prompt": {}, "raw-response": {}},
  "actions": {}
}
