  "profile_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": true, "required": ["schema_version", "name", "label"], "properties": {"schema_version": {"type": "integer", "const": 2, "default": 2}, "template_id": {"type": "string", "const": "launchd-external", "default": "launchd-external"}, "name": {"type": "string", "minLength": 1, "x-llmops-ui": {"group": "Identity", "order": 10}}, "label": {"type": "string", "minLength": 1, "x-llmops-ui": {"group": "LaunchAgent", "order": 10}}, "plist": {"type": "string", "x-llmops-ui": {"group": "LaunchAgent", "order": 20, "widget": "path"}}, "stdout": {"type": "string", "x-llmops-ui": {"group": "Logging", "order": 10, "widget": "path"}}, "stderr": {"type": "string", "x-llmops-ui": {"group": "Logging", "order": 20, "widget": "path"}}}},
