#!/usr/bin/env python3
"""Administrator workflow for staging and deploying LLM-Ops-Kit."""

from __future__ import annotations

import argparse
import concurrent.futures
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import tarfile
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any


def invoked_runtime_root(script_path: Path) -> Path:
    script_path = script_path.absolute()
    root = script_path.parents[1]
    if script_path.parent.name == "bin":
        return root / "current"
    return root


RUNTIME_ROOT = invoked_runtime_root(Path(__file__))
REPO_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO_ROOT / "scripts" / "lib"))

from llmops_paths import resolve_paths
from llmops_config import ConfigError, default_config, load_config
from gguf_metadata import GgufError, read_gguf_metadata, write_metadata_cache

DEFAULT_INVENTORY = REPO_ROOT / "deploy" / "inventory.json"
FALLBACK_INVENTORY = REPO_ROOT / "docs" / "inventory.example.json"
ADMIN_INVENTORY = resolve_paths().inventory_file
DEFAULT_STAGE_ROOT = resolve_paths().stage_dir
SUPPORTED_ROLES = {"admin", "llm", "agent", "hybrid"}
CONFIG_PRECEDENCE = (
    "global defaults",
    "role defaults",
    "model defaults",
    "profile config",
    "host config",
    "runtime environment",
    "CLI flags",
)


class AdminError(RuntimeError):
    pass


def remote_shell_path(path: str) -> str:
    """Quote a remote path while preserving inventory `~/` expansion."""
    if path == "~":
        return '"$HOME"'
    if path.startswith("~/"):
        return '"$HOME"/' + shlex.quote(path[2:])
    return shlex.quote(path)


@dataclass(frozen=True)
class HostRecord:
    name: str
    role: str
    host: str
    user: str
    port: int
    install_root: str
    config_profile: str
    ssh_key: str
    proxy_jump: str | None
    tags: tuple[str, ...]

    @property
    def destination(self) -> str:
        return f"{self.user}@{self.host}"

    @property
    def ssh_key_path(self) -> Path:
        return Path(self.ssh_key).expanduser()

    def ssh_base(self) -> list[str]:
        command = [
            "ssh",
            "-i",
            str(self.ssh_key_path),
            "-p",
            str(self.port),
            "-o",
            "BatchMode=yes",
            "-o",
            "StrictHostKeyChecking=accept-new",
        ]
        if self.proxy_jump:
            command.extend(["-o", f"ProxyJump={self.proxy_jump}"])
        command.append(self.destination)
        return command

    def scp_base(self) -> list[str]:
        command = [
            "scp",
            "-i",
            str(self.ssh_key_path),
            "-P",
            str(self.port),
            "-o",
            "BatchMode=yes",
            "-o",
            "StrictHostKeyChecking=accept-new",
        ]
        if self.proxy_jump:
            command.extend(["-o", f"ProxyJump={self.proxy_jump}"])
        return command


def _parse_scalar(raw: str) -> Any:
    value = raw.strip()
    if not value:
        return ""
    if value.startswith("[") and value.endswith("]"):
        inner = value[1:-1].strip()
        if not inner:
            return []
        return [item.strip().strip("\"'") for item in inner.split(",")]
    try:
        return int(value)
    except ValueError:
        return value.strip("\"'")


def _load_simple_yaml(path: Path) -> dict[str, Any]:
    data: dict[str, Any] = {"defaults": {}, "hosts": []}
    current: str | None = None
    current_host: dict[str, Any] | None = None
    for lineno, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        line = raw_line.split("#", 1)[0].rstrip()
        if not line.strip():
            continue
        if line.startswith("defaults:"):
            current = "defaults"
            current_host = None
            continue
        if line.startswith("hosts:"):
            current = "hosts"
            current_host = None
            continue
        stripped = line.strip()
        if current == "defaults" and line.startswith("  ") and ":" in stripped:
            key, value = stripped.split(":", 1)
            data["defaults"][key.strip()] = _parse_scalar(value)
            continue
        if current == "hosts" and line.startswith("  - "):
            current_host = {}
            data["hosts"].append(current_host)
            remainder = stripped[2:].strip()
            if remainder:
                key, value = remainder.split(":", 1)
                current_host[key.strip()] = _parse_scalar(value)
            continue
        if current == "hosts" and line.startswith("    ") and current_host is not None:
            key, value = stripped.split(":", 1)
            current_host[key.strip()] = _parse_scalar(value)
            continue
        raise AdminError(f"{path}:{lineno}: unsupported inventory syntax")
    return data


def inventory_path(args: argparse.Namespace) -> Path:
    if getattr(args, "inventory", None):
        return Path(args.inventory).expanduser()
    if ADMIN_INVENTORY.exists():
        return ADMIN_INVENTORY
    if DEFAULT_INVENTORY.exists():
        return DEFAULT_INVENTORY
    return FALLBACK_INVENTORY


def _load_inventory_json(path: Path) -> dict[str, Any]:
    raw = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(raw, dict):
        raise AdminError(f"inventory JSON must be an object: {path}")
    return raw


def load_inventory(path: Path) -> list[HostRecord]:
    if not path.exists():
        raise AdminError(f"inventory not found: {path}")
    raw = _load_inventory_json(path) if path.suffix == ".json" else _load_simple_yaml(path)
    defaults = dict(raw.get("defaults") or {})
    hosts: list[HostRecord] = []
    seen: set[str] = set()
    for item in raw.get("hosts") or []:
        merged = {**defaults, **item}
        missing = [
            key
            for key in ("name", "role", "host", "user", "port", "install_root", "config_profile", "ssh_key")
            if merged.get(key) in (None, "")
        ]
        if missing:
            raise AdminError(f"host entry missing required keys: {', '.join(missing)}")
        role = str(merged["role"])
        if role not in SUPPORTED_ROLES:
            raise AdminError(f"host {merged['name']} has unsupported role: {role}")
        name = str(merged["name"])
        if name in seen:
            raise AdminError(f"duplicate host name: {name}")
        seen.add(name)
        tags = merged.get("tags") or []
        if isinstance(tags, str):
            tags = [tags]
        hosts.append(
            HostRecord(
                name=name,
                role=role,
                host=str(merged["host"]),
                user=str(merged["user"]),
                port=int(merged["port"]),
                install_root=str(merged["install_root"]),
                config_profile=str(merged["config_profile"]),
                ssh_key=str(merged["ssh_key"]),
                proxy_jump=str(merged["proxy_jump"]) if merged.get("proxy_jump") else None,
                tags=tuple(str(tag) for tag in tags),
            )
        )
    if not hosts:
        raise AdminError(f"inventory contains no hosts: {path}")
    return hosts


def select_hosts(hosts: list[HostRecord], args: argparse.Namespace) -> list[HostRecord]:
    selected = hosts
    if getattr(args, "role", None):
        selected = [host for host in selected if host.role == args.role]
    if getattr(args, "tag", None):
        wanted = set(args.tag)
        selected = [host for host in selected if wanted.intersection(host.tags)]
    if getattr(args, "host_name", None):
        wanted_names = set(args.host_name)
        selected = [host for host in selected if host.name in wanted_names]
    if not selected:
        raise AdminError("host selection matched no inventory entries")
    return selected


def run_command(command: list[str], *, dry_run: bool = False) -> tuple[int, str]:
    rendered = " ".join(shlex.quote(part) for part in command)
    if dry_run:
        return 0, rendered
    proc = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False)
    return proc.returncode, proc.stdout


def parse_env_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip().removeprefix("export ").strip()
        value = value.strip().strip("\"'")
        if "${" in value:
            continue
        values[key] = os.path.expandvars(os.path.expanduser(value))
    return values


VAR_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
DEFAULT_EXPR_RE = re.compile(r'^\$\{([A-Za-z_][A-Za-z0-9_]*):-(.*)\}$')
VAR_REF_RE = re.compile(r'\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)')


def expand_legacy_assignment(value: str, values: dict[str, str]) -> str:
    env = {**os.environ, **values}
    match = DEFAULT_EXPR_RE.match(value)
    if match:
        value = env.get(match.group(1), match.group(2))
    if "$(" in value or "`" in value:
        return ""

    def replace(match: re.Match[str]) -> str:
        name = match.group(1) or match.group(2)
        return env.get(name, match.group(0))

    for _ in range(4):
        expanded = VAR_REF_RE.sub(replace, value)
        if expanded == value:
            break
        value = expanded
    return value


def resolve_legacy_assignment_values(values: dict[str, str]) -> dict[str, str]:
    resolved = dict(values)
    for _ in range(4):
        updated = {
            key: expand_legacy_assignment(value, resolved)
            for key, value in resolved.items()
        }
        if updated == resolved:
            break
        resolved = updated
    return {
        key: value
        for key, value in resolved.items()
        if not VAR_REF_RE.search(value) and "$(" not in value and "`" not in value
    }


def parse_legacy_assignment_file(path: Path) -> dict[str, str]:
    """Parse simple shell/env assignment files for migration reporting.

    The migration path is intentionally conservative: it records static values
    and common `${VAR:-default}` defaults without executing the shell file.
    """

    values: dict[str, str] = {}
    if not path.exists():
        return values
    lines = path.read_text(encoding="utf-8").splitlines()
    index = 0
    while index < len(lines):
        raw_line = lines[index]
        index += 1
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, raw_value = line.split("=", 1)
        key = key.strip().removeprefix("export ").strip()
        if not VAR_NAME_RE.match(key):
            continue
        raw_value = raw_value.strip()
        if raw_value.startswith("("):
            array_lines = [raw_value[1:]]
            while not any(part.strip().endswith(")") for part in array_lines) and index < len(lines):
                array_lines.append(lines[index])
                index += 1
            if key == "EXTRA_ARGS":
                tokens: list[str] = []
                for part in array_lines:
                    part = part.strip()
                    if part.endswith(")"):
                        part = part[:-1]
                    if not part or part.startswith("#"):
                        continue
                    try:
                        tokens.extend(shlex.split(part, comments=True, posix=True))
                    except ValueError:
                        tokens = []
                        break
                if tokens:
                    values["EXTRA_FLAGS"] = " ".join(
                        expand_legacy_assignment(token, values) for token in tokens
                    )
            continue
        value = raw_value.strip("\"'")
        match = DEFAULT_EXPR_RE.match(value)
        value = expand_legacy_assignment(value, values)
        if value:
            values[key] = value
    return values


def config_layers_for(host: HostRecord, model: str | None = None) -> list[tuple[str, Path]]:
    admin_config = Path("~/.llm-ops/config").expanduser()
    layers: list[tuple[str, Path]] = [
        ("global defaults", REPO_ROOT / "defaults" / "global.env"),
        ("role defaults", REPO_ROOT / "defaults" / "roles" / f"{host.role}.env"),
    ]
    if model:
        layers.append(("model defaults", REPO_ROOT / "models" / f"{model}.env"))
        layers.append(("model defaults", REPO_ROOT / "scripts" / "models" / f"{model}.sh"))
    layers.extend(
        [
            ("profile config", admin_config / "profiles" / f"{host.config_profile}.env"),
            ("host config", admin_config / "hosts" / f"{host.name}.env"),
        ]
    )
    return layers


def effective_config(host: HostRecord, model: str | None, cli_values: dict[str, str] | None = None) -> dict[str, dict[str, str]]:
    result: dict[str, dict[str, str]] = {}
    for layer_name, path in config_layers_for(host, model):
        for key, value in parse_env_file(path).items():
            result[key] = {"value": value, "source": f"{layer_name}:{path}"}
    for key in ("MODEL", "PORT", "HOST", "CHAT_TEMPLATE", "USE_CUSTOM_TEMPLATE", "MODEL_PROFILE"):
        if key in os.environ:
            result[key] = {"value": os.environ[key], "source": "runtime environment"}
    for key, value in (cli_values or {}).items():
        result[key] = {"value": value, "source": "CLI flags"}
    return result


def write_host_config(stage_dir: Path, host: HostRecord, model: str | None) -> Path:
    config = effective_config(host, model)
    host_dir = stage_dir / "hosts" / host.name
    host_dir.mkdir(parents=True, exist_ok=True)
    config_path = host_dir / "config.env"
    lines = [
        "# Generated by llmops-admin stage.",
        f"LLMOPS_HOST_NAME={host.name}",
        f"LLMOPS_HOST_ROLE={host.role}",
        f"LLMOPS_CONFIG_PROFILE={host.config_profile}",
    ]
    for key in sorted(config):
        lines.append(f"{key}={shlex.quote(config[key]['value'])}")
    config_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    (host_dir / "config-sources.json").write_text(json.dumps(config, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    host_config = {
        "schema_version": 1,
        "host": {
            "name": host.name,
            "role": host.role,
            "address": host.host,
            "user": host.user,
            "port": host.port,
            "install_root": host.install_root,
            "config_profile": host.config_profile,
            "proxy_jump": host.proxy_jump,
            "tags": list(host.tags),
        },
        "model": model,
        "config": {
            key: {"value": meta["value"], "source": meta["source"]}
            for key, meta in sorted(config.items())
        },
    }
    (host_dir / "config.json").write_text(json.dumps(host_config, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return config_path


def build_package(stage_dir: Path) -> Path:
    package_path = stage_dir / "package" / "llm-ops-kit.tar.gz"
    package_path.parent.mkdir(parents=True, exist_ok=True)

    def package_filter(info: tarfile.TarInfo) -> tarfile.TarInfo | None:
        parts = Path(info.name).parts
        if "tests" in parts or "__pycache__" in parts:
            return None
        if info.name.endswith(("/.DS_Store", ".pyc", ".pyo")):
            return None
        return info

    with tarfile.open(package_path, "w:gz") as tar:
        for name in ("scripts", "bin"):
            path = REPO_ROOT / name
            tar.add(path, arcname=Path("LLM-Ops-Kit") / name, filter=package_filter)
    return package_path


def file_sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def write_manifest(stage_dir: Path, package_path: Path, hosts: list[HostRecord], model: str | None) -> Path:
    host_entries: list[dict[str, Any]] = []
    for host in hosts:
        host_dir = stage_dir / "hosts" / host.name
        config_env = host_dir / "config.env"
        config_json = host_dir / "config.json"
        config_sources = host_dir / "config-sources.json"
        host_entries.append(
            {
                "name": host.name,
                "role": host.role,
                "host": host.host,
                "user": host.user,
                "port": host.port,
                "install_root": host.install_root,
                "config_profile": host.config_profile,
                "ssh_key": host.ssh_key,
                "proxy_jump": host.proxy_jump,
                "tags": list(host.tags),
                "config_env": str(config_env),
                "config_env_sha256": file_sha256(config_env),
                "config_json": str(config_json),
                "config_json_sha256": file_sha256(config_json),
                "config_sources": str(config_sources),
                "config_sources_sha256": file_sha256(config_sources),
            }
        )
    manifest = {
        "bundle_id": stage_dir.name,
        "created_at": int(time.time()),
        "repo_root": str(REPO_ROOT),
        "package": str(package_path),
        "package_sha256": file_sha256(package_path),
        "model": model,
        "config_precedence": CONFIG_PRECEDENCE,
        "hosts": host_entries,
    }
    manifest_path = stage_dir / "manifest.json"
    manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return manifest_path


def validate_stage_bundle(stage_dir: Path, hosts: list[HostRecord], *, require_package: bool) -> None:
    missing: list[Path] = []
    if not stage_dir.is_dir():
        raise AdminError(f"stage directory not found: {stage_dir}")
    manifest_path = stage_dir / "manifest.json"
    required = [manifest_path]
    if require_package:
        required.append(stage_dir / "package" / "llm-ops-kit.tar.gz")
    for host in hosts:
        host_dir = stage_dir / "hosts" / host.name
        required.extend(
            [
                host_dir / "config.env",
                host_dir / "config.json",
                host_dir / "config-sources.json",
            ]
        )
    for path in required:
        if not path.exists():
            missing.append(path)
    if missing:
        rendered = "\n".join(f"missing stage artifact: {path}" for path in missing)
        raise AdminError(f"incomplete stage bundle: {stage_dir}\n{rendered}")
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise AdminError(f"invalid stage manifest JSON: {manifest_path}: {exc}") from exc
    if not isinstance(manifest, dict):
        raise AdminError(f"invalid stage manifest: {manifest_path}: top-level value must be an object")
    if manifest.get("bundle_id") != stage_dir.name:
        raise AdminError(f"stage manifest bundle_id does not match stage directory: {manifest_path}")
    package_path = stage_dir / "package" / "llm-ops-kit.tar.gz"
    if require_package and manifest.get("package_sha256") != file_sha256(package_path):
        raise AdminError(f"stage package checksum mismatch: {package_path}")
    manifest_hosts = {
        str(item.get("name")): item
        for item in manifest.get("hosts", [])
        if isinstance(item, dict) and item.get("name")
    }
    for host in hosts:
        item = manifest_hosts.get(host.name)
        if item is None:
            raise AdminError(f"stage manifest missing selected host: {host.name}")
        host_dir = stage_dir / "hosts" / host.name
        config_env = host_dir / "config.env"
        config_json = host_dir / "config.json"
        config_sources = host_dir / "config-sources.json"
        if item.get("config_env_sha256") != file_sha256(config_env):
            raise AdminError(f"stage config.env checksum mismatch: {config_env}")
        if item.get("config_json_sha256") != file_sha256(config_json):
            raise AdminError(f"stage config.json checksum mismatch: {config_json}")
        if item.get("config_sources_sha256") != file_sha256(config_sources):
            raise AdminError(f"stage config-sources.json checksum mismatch: {config_sources}")


def latest_stage(stage_root: Path) -> Path:
    candidates = sorted(path for path in stage_root.glob("*") if path.is_dir())
    if not candidates:
        raise AdminError(f"no staged bundles found under {stage_root}")
    return candidates[-1]


def cmd_inventory_validate(args: argparse.Namespace) -> int:
    path = inventory_path(args)
    hosts = select_hosts(load_inventory(path), args)
    print(f"inventory OK: {path}")
    for host in hosts:
        print(f"{host.name}\trole={host.role}\thost={host.destination}\tprofile={host.config_profile}\ttags={','.join(host.tags)}")
    return 0


def cmd_bootstrap_host(args: argparse.Namespace) -> int:
    failures = 0
    for host in select_hosts(load_inventory(inventory_path(args)), args):
        key_path = host.ssh_key_path
        commands: list[list[str]] = []
        if not key_path.exists():
            commands.append(["ssh-keygen", "-t", "ed25519", "-f", str(key_path), "-N", "", "-C", f"llmops:{host.name}"])
        copy_id = ["ssh-copy-id", "-i", f"{key_path}.pub", "-p", str(host.port)]
        if host.proxy_jump:
            copy_id.extend(["-o", f"ProxyJump={host.proxy_jump}"])
        copy_id.append(host.destination)
        commands.append(copy_id)
        root = remote_shell_path(host.install_root)
        remote = f"mkdir -p {root}/{{packages,run,logs,config}} && touch {root}/.llmops-ready"
        commands.append(host.ssh_base() + [remote])
        for command in commands:
            code, output = run_command(command, dry_run=args.dry_run)
            print(f"[{host.name}] {output.strip()}")
            if code != 0:
                failures += 1
                break
    return 1 if failures else 0


def cmd_stage(args: argparse.Namespace) -> int:
    hosts = select_hosts(load_inventory(inventory_path(args)), args)
    bundle_id = args.bundle_id or time.strftime("%Y%m%d-%H%M%S")
    stage_dir = Path(args.stage_root).expanduser() / bundle_id
    if args.dry_run:
        print(f"stage dry-run: would create {stage_dir}")
        for host in hosts:
            host_dir = stage_dir / "hosts" / host.name
            print(f"stage dry-run: would render config for {host.name} ({host.role})")
            print(f"stage dry-run: would write {host_dir / 'config.env'}")
            print(f"stage dry-run: would write {host_dir / 'config.json'}")
        return 0
    stage_dir.mkdir(parents=True, exist_ok=False)
    package_path = build_package(stage_dir)
    for host in hosts:
        write_host_config(stage_dir, host, args.model)
    manifest_path = write_manifest(stage_dir, package_path, hosts, args.model)
    validate_stage_bundle(stage_dir, hosts, require_package=True)
    print(f"stage created: {stage_dir}")
    print(f"package: {package_path}")
    print(f"manifest: {manifest_path}")
    print("stage validation: OK")
    return 0


def push_one(host: HostRecord, stage_dir: Path, dry_run: bool) -> tuple[str, int, str]:
    package = stage_dir / "package" / "llm-ops-kit.tar.gz"
    manifest = stage_dir / "manifest.json"
    host_config = stage_dir / "hosts" / host.name / "config.env"
    host_config_json = stage_dir / "hosts" / host.name / "config.json"
    host_config_sources = stage_dir / "hosts" / host.name / "config-sources.json"
    remote_package_dir = f"{host.install_root}/packages/{stage_dir.name}"
    remote_root = remote_shell_path(host.install_root)
    bundle = shlex.quote(stage_dir.name)
    commands = [
        host.ssh_base() + [f"mkdir -p {remote_root}/packages/{bundle} {remote_root}/config"],
        host.scp_base() + [str(package), f"{host.destination}:{remote_package_dir}/"],
        host.scp_base() + [str(manifest), f"{host.destination}:{remote_package_dir}/manifest.json"],
        host.scp_base() + [str(host_config), f"{host.destination}:{host.install_root}/config/{host.name}.env"],
        host.scp_base() + [str(host_config_json), f"{host.destination}:{host.install_root}/config/{host.name}.json"],
        host.scp_base() + [
            str(host_config_sources),
            f"{host.destination}:{host.install_root}/config/{host.name}.sources.json",
        ],
    ]
    output: list[str] = []
    for command in commands:
        code, text = run_command(command, dry_run=dry_run)
        output.append(text.strip())
        if code != 0:
            return host.name, code, "\n".join(output)
    return host.name, 0, "\n".join(output)


def cmd_push(args: argparse.Namespace) -> int:
    hosts = select_hosts(load_inventory(inventory_path(args)), args)
    stage_dir = Path(args.stage).expanduser() if args.stage else latest_stage(Path(args.stage_root).expanduser())
    validate_stage_bundle(stage_dir, hosts, require_package=True)
    failures = 0
    started = time.time()
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.workers) as pool:
        futures = [pool.submit(push_one, host, stage_dir, args.dry_run) for host in hosts]
        for future in concurrent.futures.as_completed(futures):
            name, code, output = future.result()
            print(f"[{name}] push {'OK' if code == 0 else f'FAILED({code})'}")
            if output:
                print(output)
            if code != 0:
                failures += 1
    print(f"push complete: hosts={len(hosts)} failures={failures} elapsed={time.time() - started:.1f}s")
    return 1 if failures else 0


def apply_one(host: HostRecord, stage_dir: Path, dry_run: bool, restart: str | None) -> tuple[str, int, str]:
    manifest_path = stage_dir / "manifest.json"
    manifest_data = json.loads(manifest_path.read_text(encoding="utf-8"))
    host_data = next(item for item in manifest_data["hosts"] if item["name"] == host.name)
    root = remote_shell_path(host.install_root)
    bundle = shlex.quote(stage_dir.name)
    host_name = shlex.quote(host.name)
    package_sha256 = shlex.quote(str(manifest_data["package_sha256"]))
    manifest_sha256 = shlex.quote(file_sha256(manifest_path))
    config_env_sha256 = shlex.quote(str(host_data["config_env_sha256"]))
    config_json_sha256 = shlex.quote(str(host_data["config_json_sha256"]))
    config_sources_sha256 = shlex.quote(str(host_data["config_sources_sha256"]))
    commands = [
        "set -eu",
        f"root={root}",
        f"bundle={bundle}",
        f"host_name={host_name}",
        f"expected_package_sha256={package_sha256}",
        f"expected_manifest_sha256={manifest_sha256}",
        f"expected_config_env_sha256={config_env_sha256}",
        f"expected_config_json_sha256={config_json_sha256}",
        f"expected_config_sources_sha256={config_sources_sha256}",
        'package="$root/packages/$bundle/llm-ops-kit.tar.gz"',
        'manifest="$root/packages/$bundle/manifest.json"',
        'remote_config_env="$root/config/$host_name.env"',
        'remote_config_json="$root/config/$host_name.json"',
        'remote_config_sources="$root/config/$host_name.sources.json"',
        'release="$root/releases/$bundle"',
        'release_config="$release/config"',
        'current="$root/current"',
        'old_target=""',
        'previous_old_target=""',
        'previous_existed=0',
        'switched=0',
        'release_created=0',
        'checksum() { if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk \'{print $1}\'; '
        'else sha256sum "$1" | awk \'{print $1}\'; fi; }',
        'replace_link() { src=$1; dst=$2; '
        'if mv -fh "$src" "$dst" 2>/dev/null; then return 0; fi; '
        'if mv -fT "$src" "$dst" 2>/dev/null; then return 0; fi; '
        'rm -f "$dst"; mv -f "$src" "$dst"; }',
        'rollback() { rc=$?; trap - EXIT HUP INT TERM; '
        'if [ "$switched" -eq 1 ]; then '
        'if [ -n "$old_target" ]; then ln -s "$old_target" "$root/.current.rollback.$$"; '
        'replace_link "$root/.current.rollback.$$" "$current"; else rm -f "$current"; fi; '
        'if [ "$previous_existed" -eq 1 ]; then ln -s "$previous_old_target" "$root/.previous.rollback.$$"; '
        'replace_link "$root/.previous.rollback.$$" "$root/previous"; else rm -f "$root/previous"; fi; fi; '
        'if [ "$release_created" -eq 1 ]; then rm -rf "$release"; fi; exit "$rc"; }',
        'trap rollback EXIT HUP INT TERM',
        'test -f "$package"',
        'test -f "$manifest"',
        'test -f "$remote_config_env"',
        'test -f "$remote_config_json"',
        'test -f "$remote_config_sources"',
        'test "$(checksum "$package")" = "$expected_package_sha256"',
        'test "$(checksum "$manifest")" = "$expected_manifest_sha256"',
        'test "$(checksum "$remote_config_env")" = "$expected_config_env_sha256"',
        'test "$(checksum "$remote_config_json")" = "$expected_config_json_sha256"',
        'test "$(checksum "$remote_config_sources")" = "$expected_config_sources_sha256"',
        'test ! -e "$release"',
        'mkdir -p "$release_config"',
        'release_created=1',
        'tar -xzf "$package" -C "$release" --strip-components=1',
        'cp "$manifest" "$release/manifest.json"',
        'cp "$remote_config_env" "$release_config/$host_name.env"',
        'cp "$remote_config_json" "$release_config/$host_name.json"',
        'cp "$remote_config_sources" "$release_config/$host_name.sources.json"',
        'printf \'%s\\n\' "$bundle" > "$release/BUNDLE_ID"',
        'printf \'%s\\n\' "$host_name" > "$release/HOST_NAME"',
        'if [ -L "$current" ]; then old_target=$(readlink "$current"); '
        'elif [ -e "$current" ]; then old_target="$root/releases/legacy-current-$(date +%Y%m%d-%H%M%S)-$$"; '
        'mv "$current" "$old_target"; fi',
        'if [ -L "$root/previous" ]; then previous_old_target=$(readlink "$root/previous"); previous_existed=1; fi',
        'switched=1',
        'if [ -n "$old_target" ]; then ln -s "$old_target" "$root/.previous.new.$$"; '
        'replace_link "$root/.previous.new.$$" "$root/previous"; fi',
        'ln -s "$release" "$root/.current.new.$$"',
        'replace_link "$root/.current.new.$$" "$current"',
        'BIN_DIR="$root/bin" RUNTIME_DIR="$current" bash "$current/scripts/deploy-runtime-links.sh" --replace-managed-links',
    ]
    if restart:
        commands.append(f'bash "$current/scripts/{shlex.quote(restart)}" restart')
    if host.role in {"llm", "hybrid"}:
        commands.append('test -x "$current/scripts/modelctl"')
    if host.role in {"agent", "hybrid"}:
        commands.append('test -x "$current/scripts/agentctl"')
    commands.extend(["trap - EXIT HUP INT TERM", "exit 0"])
    code, output = run_command(host.ssh_base() + ["; ".join(commands)], dry_run=dry_run)
    return host.name, code, output


def cmd_apply(args: argparse.Namespace) -> int:
    hosts = select_hosts(load_inventory(inventory_path(args)), args)
    stage_dir = Path(args.stage).expanduser() if args.stage else latest_stage(Path(args.stage_root).expanduser())
    validate_stage_bundle(stage_dir, hosts, require_package=False)
    failures = 0
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.workers) as pool:
        futures = [pool.submit(apply_one, host, stage_dir, args.dry_run, args.restart) for host in hosts]
        for future in concurrent.futures.as_completed(futures):
            name, code, output = future.result()
            print(f"[{name}] apply {'OK' if code == 0 else f'FAILED({code})'}")
            if output:
                print(output.strip())
            if code != 0:
                failures += 1
    return 1 if failures else 0


def cmd_stage_validate(args: argparse.Namespace) -> int:
    hosts = select_hosts(load_inventory(inventory_path(args)), args)
    stage_dir = Path(args.stage).expanduser() if args.stage else latest_stage(Path(args.stage_root).expanduser())
    validate_stage_bundle(stage_dir, hosts, require_package=not args.no_package)
    print(f"stage OK: {stage_dir}")
    print(f"selected_hosts={len(hosts)}")
    print(f"package_required={0 if args.no_package else 1}")
    return 0


def cmd_deploy_report(args: argparse.Namespace) -> int:
    hosts = select_hosts(load_inventory(inventory_path(args)), args)
    stage_dir = Path(args.stage).expanduser() if args.stage else latest_stage(Path(args.stage_root).expanduser())
    validate_stage_bundle(stage_dir, hosts, require_package=not args.no_package)
    manifest = json.loads((stage_dir / "manifest.json").read_text(encoding="utf-8"))
    print(f"stage={stage_dir}")
    print(f"bundle_id={manifest.get('bundle_id')}")
    print(f"package={manifest.get('package')}")
    print(f"package_sha256={manifest.get('package_sha256')}")
    print(f"selected_hosts={len(hosts)}")
    manifest_hosts = {
        str(item.get("name")): item
        for item in manifest.get("hosts", [])
        if isinstance(item, dict) and item.get("name")
    }
    for host in hosts:
        item = manifest_hosts[host.name]
        release_dir = f"{host.install_root}/releases/{stage_dir.name}"
        print(
            "host"
            f"\tname={host.name}"
            f"\trole={host.role}"
            f"\tdestination={host.destination}"
            f"\tremote_package={host.install_root}/packages/{stage_dir.name}/llm-ops-kit.tar.gz"
            f"\tremote_manifest={host.install_root}/packages/{stage_dir.name}/manifest.json"
            f"\trelease_dir={release_dir}"
            f"\trelease_config_dir={release_dir}/config"
            f"\tconfig_env_sha256={item.get('config_env_sha256')}"
            f"\tconfig_json_sha256={item.get('config_json_sha256')}"
            f"\tconfig_sources_sha256={item.get('config_sources_sha256')}"
        )
    return 0


def cmd_config_settings(args: argparse.Namespace) -> int:
    for host in select_hosts(load_inventory(inventory_path(args)), args):
        print(f"[{host.name}]")
        for key, meta in sorted(effective_config(host, args.model).items()):
            print(f"{key}={meta['value']}\t# {meta['source']}")
    return 0


def print_path_report() -> None:
    paths = resolve_paths()
    config = load_config(paths=paths)
    print("Resolved LLM-Ops-Kit paths:")
    for key, value in paths.as_dict().items():
        print(f"{key}={value}")
    print(f"config_status={'present' if config.exists else 'missing'}")
    print(f"config_schema_version={config.schema_version}")


def cmd_config_doctor(args: argparse.Namespace) -> int:
    if getattr(args, "dry_run", False):
        print_path_report()
        return 0
    failures = 0
    for host in select_hosts(load_inventory(inventory_path(args)), args):
        config = effective_config(host, args.model)
        print(f"[{host.name}]")
        port = config.get("PORT", {}).get("value")
        if port and not str(port).isdigit():
            print(f"ERROR PORT is not numeric: {port}")
            failures += 1
        template = config.get("CHAT_TEMPLATE", {}).get("value")
        if config.get("USE_CUSTOM_TEMPLATE", {}).get("value") == "1" and template and not Path(template).expanduser().exists():
            print(f"ERROR CHAT_TEMPLATE does not exist: {template}")
            failures += 1
        if failures == 0:
            print("OK")
    return 1 if failures else 0


def migration_sources(legacy_home: Path) -> list[tuple[str, Path]]:
    config_dir = legacy_home / "config"
    sources: list[tuple[str, Path]] = [
        ("legacy global config", legacy_home / "config.env"),
        ("repo host defaults", REPO_ROOT / "scripts" / "config" / "hosts.env"),
    ]
    for path in sorted(config_dir.glob("*.env")):
        sources.append(("legacy model override", path))
    for path in sorted(config_dir.glob("*.sh")):
        sources.append(("legacy model override", path))
    for path in sorted((config_dir / "agents").glob("*.env")):
        sources.append(("legacy agent override", path))
    for path in sorted((REPO_ROOT / "scripts" / "models").glob("*.sh")):
        sources.append(("repo model profile", path))
    for path in sorted((REPO_ROOT / "scripts" / "agents").glob("*.env")):
        sources.append(("repo agent profile", path))
    return sources


@dataclass(frozen=True)
class MigrationDestinations:
    config_file: Path
    inventory_file: Path
    models_dir: Path
    agents_dir: Path
    profiles_dir: Path
    services_dir: Path


def migration_destinations(output: str | None) -> MigrationDestinations:
    paths = resolve_paths()
    config_file = Path(output).expanduser() if output else paths.config_file
    config_home = config_file.parent
    return MigrationDestinations(
        config_file=config_file,
        inventory_file=config_home / "inventory.json",
        models_dir=config_home / "models",
        agents_dir=config_home / "agents",
        profiles_dir=config_home / "profiles",
        services_dir=config_home / "services",
    )


def migration_inventory_source(legacy_home: Path) -> Path | None:
    legacy_inventory = legacy_home / "inventory.yml"
    if legacy_inventory.exists():
        return legacy_inventory
    if ADMIN_INVENTORY.exists():
        return ADMIN_INVENTORY
    if DEFAULT_INVENTORY.exists():
        return DEFAULT_INVENTORY
    if FALLBACK_INVENTORY.exists():
        return FALLBACK_INVENTORY
    return None


def source_record(label: str, path: Path) -> dict[str, str]:
    return {
        "label": label,
        "path": str(path),
        "status": "present" if path.exists() else "missing",
    }


def build_model_proxy_service_profile(values: dict[str, str]) -> dict[str, Any] | None:
    relevant = {
        "LLMOPS_UPSTREAM_HOST",
        "LLMOPS_UPSTREAM_PORT",
        "MODEL_PROXY_LISTEN_HOST",
        "MODEL_PROXY_LISTEN_PORT",
        "MODEL_PROXY_PYTHON_BIN",
        "MODEL_PROXY_CHAT_TEMPLATE",
        "MODEL_PROXY_LOG_ROTATE_SECONDS",
        "MODEL_PROXY_LOG_ROTATE_KEEP",
    }
    if not any(key in values for key in relevant):
        return None
    runtime: dict[str, Any] = {}
    logging: dict[str, Any] = {}
    template: dict[str, Any] = {}
    if "LLMOPS_UPSTREAM_HOST" in values:
        runtime["upstream_host"] = values["LLMOPS_UPSTREAM_HOST"]
    if "LLMOPS_UPSTREAM_PORT" in values:
        runtime["upstream_port"] = values["LLMOPS_UPSTREAM_PORT"]
    if "MODEL_PROXY_LISTEN_HOST" in values:
        runtime["listen_host"] = values["MODEL_PROXY_LISTEN_HOST"]
    if "MODEL_PROXY_LISTEN_PORT" in values:
        runtime["listen_port"] = values["MODEL_PROXY_LISTEN_PORT"]
    if "MODEL_PROXY_PYTHON_BIN" in values:
        runtime["python_bin"] = values["MODEL_PROXY_PYTHON_BIN"]
    if "MODEL_PROXY_CHAT_TEMPLATE" in values:
        template["path"] = values["MODEL_PROXY_CHAT_TEMPLATE"]
    if "MODEL_PROXY_LOG_ROTATE_SECONDS" in values:
        logging["rotate_seconds"] = values["MODEL_PROXY_LOG_ROTATE_SECONDS"]
    if "MODEL_PROXY_LOG_ROTATE_KEEP" in values:
        logging["rotate_keep"] = values["MODEL_PROXY_LOG_ROTATE_KEEP"]
    profile: dict[str, Any] = {
        "schema_version": 1,
        "name": "model-proxy",
        "runtime": runtime,
    }
    if template:
        profile["template"] = template
    if logging:
        profile["logging"] = logging
    return profile


def build_tts_bridge_service_profile(values: dict[str, str]) -> dict[str, Any] | None:
    relevant = {
        "TTS_BRIDGE_HOST",
        "TTS_BRIDGE_PORT",
        "TTS_BRIDGE_UPSTREAM_BASE",
        "TTS_BRIDGE_MODEL",
        "TTS_BRIDGE_CONFIG_DIR",
        "TTS_BRIDGE_PRONOUNCE_CONFIG",
        "TTS_BRIDGE_VOICE_MAP_CONFIG",
        "TTS_BRIDGE_SAMPLES_DIR",
        "TTS_BRIDGE_LOG_ROTATE_SECONDS",
        "TTS_BRIDGE_LOG_ROTATE_KEEP",
        "TTS_BRIDGE_REF_AUDIO",
        "TTS_BRIDGE_REF_TEXT",
        "TTS_BRIDGE_PYTHON_BIN",
    }
    if not any(key in values for key in relevant):
        return None
    runtime: dict[str, Any] = {}
    paths: dict[str, Any] = {}
    logging: dict[str, Any] = {}
    defaults: dict[str, Any] = {}
    if "TTS_BRIDGE_HOST" in values:
        runtime["host"] = values["TTS_BRIDGE_HOST"]
    if "TTS_BRIDGE_PORT" in values:
        runtime["port"] = values["TTS_BRIDGE_PORT"]
    if "TTS_BRIDGE_UPSTREAM_BASE" in values:
        runtime["upstream_base"] = values["TTS_BRIDGE_UPSTREAM_BASE"]
    if "TTS_BRIDGE_PYTHON_BIN" in values:
        runtime["python_bin"] = values["TTS_BRIDGE_PYTHON_BIN"]
    if "TTS_BRIDGE_MODEL" in values:
        paths["model"] = values["TTS_BRIDGE_MODEL"]
    if "TTS_BRIDGE_CONFIG_DIR" in values:
        paths["config_dir"] = values["TTS_BRIDGE_CONFIG_DIR"]
    if "TTS_BRIDGE_PRONOUNCE_CONFIG" in values:
        paths["pronounce_config"] = values["TTS_BRIDGE_PRONOUNCE_CONFIG"]
    if "TTS_BRIDGE_VOICE_MAP_CONFIG" in values:
        paths["voice_map_config"] = values["TTS_BRIDGE_VOICE_MAP_CONFIG"]
    if "TTS_BRIDGE_SAMPLES_DIR" in values:
        paths["samples_dir"] = values["TTS_BRIDGE_SAMPLES_DIR"]
    if "TTS_BRIDGE_LOG_ROTATE_SECONDS" in values:
        logging["rotate_seconds"] = values["TTS_BRIDGE_LOG_ROTATE_SECONDS"]
    if "TTS_BRIDGE_LOG_ROTATE_KEEP" in values:
        logging["rotate_keep"] = values["TTS_BRIDGE_LOG_ROTATE_KEEP"]
    if "TTS_BRIDGE_REF_AUDIO" in values:
        defaults["ref_audio"] = values["TTS_BRIDGE_REF_AUDIO"]
    if "TTS_BRIDGE_REF_TEXT" in values:
        defaults["ref_text"] = values["TTS_BRIDGE_REF_TEXT"]
    profile = {
        "schema_version": 1,
        "name": "tts-bridge",
        "runtime": runtime,
    }
    if paths:
        profile["paths"] = paths
    if logging:
        profile["logging"] = logging
    if defaults:
        profile["defaults"] = defaults
    return profile


def migration_processing_order(sources: list[tuple[str, Path]]) -> list[tuple[str, Path]]:
    precedence = {
        "repo host defaults": 10,
        "repo model profile": 20,
        "repo agent profile": 20,
        "legacy global config": 30,
        "legacy model override": 40,
        "legacy agent override": 40,
    }
    return sorted(sources, key=lambda item: precedence.get(item[0], 100))


def rebase_legacy_runtime_paths(values: dict[str, str], legacy_home: Path) -> dict[str, str]:
    legacy_runtime = str(legacy_home / "current")
    installed_runtime = str(RUNTIME_ROOT)
    return {
        key: installed_runtime + value[len(legacy_runtime) :]
        if value == legacy_runtime or value.startswith(legacy_runtime + "/")
        else value
        for key, value in values.items()
    }


def migration_documents(legacy_home: Path) -> dict[Path, dict[str, Any]]:
    destinations = migration_destinations(None)
    documents: dict[Path, dict[str, Any]] = {}
    sources = migration_sources(legacy_home)
    config_env: dict[str, str] = {}
    host_defaults: dict[str, str] = {}
    models: dict[str, dict[str, Any]] = {}
    agents: dict[str, dict[str, Any]] = {}

    for label, path in migration_processing_order(sources):
        values = rebase_legacy_runtime_paths(parse_legacy_assignment_file(path), legacy_home)
        if label == "legacy global config":
            config_env.update(values)
        elif label == "repo host defaults":
            host_defaults.update(values)
        elif "model" in label and path.exists():
            stem = path.stem
            key = stem.lower()
            model = models.setdefault(
                key,
                {
                    "schema_version": 1,
                    "name": stem,
                    "type": None,
                    "env": {},
                    "sources": [],
                },
            )
            if label == "repo model profile":
                model["name"] = stem
            model["sources"].append(source_record(label, path))
            model["env"].update(values)
            if values.get("MODEL_TYPE"):
                model["type"] = values["MODEL_TYPE"]
        elif "agent" in label and path.exists():
            stem = path.stem
            agent = agents.setdefault(
                stem,
                {
                    "schema_version": 1,
                    "name": stem,
                    "env": {},
                    "sources": [],
                },
            )
            agent["sources"].append(source_record(label, path))
            agent["env"].update(values)

    config_env = resolve_legacy_assignment_values(config_env)
    host_defaults = resolve_legacy_assignment_values(host_defaults)
    for model in models.values():
        model["env"] = resolve_legacy_assignment_values(model["env"])
    for agent in agents.values():
        agent["env"] = resolve_legacy_assignment_values(agent["env"])

    config = default_config()
    config["runtime"] = {
        "env": config_env,
        "host_defaults": host_defaults,
    }
    config["migration"] = {
        "legacy_home": str(legacy_home),
        "sources": [source_record(label, path) for label, path in sources],
    }
    documents[destinations.config_file] = config
    service_values = {**host_defaults, **config_env}
    legacy_pronounce = legacy_home / "pronounce.json"
    legacy_voice_map = legacy_home / "voice-map.json"
    if legacy_pronounce.is_file() or legacy_voice_map.is_file():
        service_values.setdefault("TTS_BRIDGE_CONFIG_DIR", str(legacy_home))
    if legacy_pronounce.is_file():
        service_values.setdefault("TTS_BRIDGE_PRONOUNCE_CONFIG", str(legacy_pronounce))
    if legacy_voice_map.is_file():
        service_values.setdefault("TTS_BRIDGE_VOICE_MAP_CONFIG", str(legacy_voice_map))
    model_proxy = build_model_proxy_service_profile(service_values)
    if model_proxy is not None:
        documents[destinations.services_dir / "model-proxy.json"] = model_proxy
    tts_bridge = build_tts_bridge_service_profile(service_values)
    if tts_bridge is not None:
        documents[destinations.services_dir / "tts-bridge.json"] = tts_bridge
    inventory_source = migration_inventory_source(legacy_home)
    if inventory_source is not None:
        hosts = load_inventory(inventory_source)
        documents[destinations.inventory_file] = {
            "schema_version": 1,
            "source": source_record("inventory", inventory_source),
            "hosts": [
                {
                    "name": host.name,
                    "role": host.role,
                    "host": host.host,
                    "user": host.user,
                    "port": host.port,
                    "install_root": host.install_root,
                    "config_profile": host.config_profile,
                    "ssh_key": host.ssh_key,
                    "tags": list(host.tags),
                }
                for host in hosts
            ],
        }
    for _, model in sorted(models.items()):
        documents[destinations.models_dir / f"{model['name']}.json"] = model
    for name, agent in sorted(agents.items()):
        documents[destinations.agents_dir / f"{name}.json"] = agent
    return documents


def remap_documents(documents: dict[Path, dict[str, Any]], destinations: MigrationDestinations) -> dict[Path, dict[str, Any]]:
    default_destinations = migration_destinations(None)
    remapped: dict[Path, dict[str, Any]] = {}
    for path, document in documents.items():
        if path == default_destinations.config_file:
            remapped[destinations.config_file] = document
        elif path == default_destinations.inventory_file:
            remapped[destinations.inventory_file] = document
        elif path.parent == default_destinations.models_dir:
            remapped[destinations.models_dir / path.name] = document
        elif path.parent == default_destinations.agents_dir:
            remapped[destinations.agents_dir / path.name] = document
        elif path.parent == default_destinations.services_dir:
            remapped[destinations.services_dir / path.name] = document
        else:
            remapped[path] = document
    return remapped


def write_json_document(path: Path, document: dict[str, Any], *, force: bool) -> None:
    if path.exists() and not force:
        raise AdminError(f"destination already exists; use --force to overwrite: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(document, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def cmd_migrate_config(args: argparse.Namespace) -> int:
    legacy_home = Path(args.legacy_home).expanduser()
    destinations = migration_destinations(args.output)
    documents = remap_documents(migration_documents(legacy_home), destinations)
    print(f"migration_mode={'dry-run' if args.dry_run else 'write'}")
    print(f"legacy_home={legacy_home}")
    print(f"destination_config={destinations.config_file}")
    print(f"destination_inventory={destinations.inventory_file}")
    print(f"destination_models_dir={destinations.models_dir}")
    print(f"destination_agents_dir={destinations.agents_dir}")
    print(f"destination_profiles_dir={destinations.profiles_dir}")
    print(f"destination_services_dir={destinations.services_dir}")
    for label, path in migration_sources(legacy_home):
        status = "present" if path.exists() else "missing"
        print(f"source\t{status}\t{label}\t{path}")
    inventory_source = migration_inventory_source(legacy_home)
    if inventory_source is not None:
        print(f"source\tpresent\tinventory\t{inventory_source}")
    for path in sorted(documents):
        print(f"destination\t{path}")
    if args.dry_run:
        print("dry-run: no files written")
        return 0
    for path, document in sorted(documents.items()):
        write_json_document(path, document, force=args.force)
        print(f"wrote {path}")
    return 0


def cmd_model_inspect(args: argparse.Namespace) -> int:
    result = read_gguf_metadata(Path(args.gguf))
    cache_path = None if args.no_cache else write_metadata_cache(result, resolve_paths().gguf_metadata_cache_dir)
    if args.json:
        payload = {
            "path": str(result.path),
            "version": result.version,
            "tensor_count": result.tensor_count,
            "metadata": result.metadata,
            "profile_defaults": result.profile_defaults(),
            "cache_path": str(cache_path) if cache_path else None,
        }
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    print(f"model_path={result.path}")
    print(f"model_id={result.model_id}")
    print(f"name={result.name}")
    print(f"architecture={result.architecture}")
    print(f"context_length={result.context_length or ''}")
    print(f"gguf_version={result.version}")
    print(f"tensor_count={result.tensor_count}")
    print(f"metadata_keys={len(result.metadata)}")
    if cache_path:
        print(f"cache_path={cache_path}")
    return 0


def build_model_profile(
    result: Any,
    *,
    profile_name: str,
    host: str,
    port: int,
    gpu_layers: str,
    template: str,
    cache_prompt: bool = False,
    cache_reuse: int | None = None,
    slot_save_path: str | None = None,
    spec_type: str | None = None,
    spec_ngram_size_n: int | None = None,
    spec_ngram_size_m: int | None = None,
    perf: bool = False,
    flash_attention: bool = False,
    no_cpu_moe: bool = False,
    no_host: bool = False,
    extra_flags: list[str] | None = None,
) -> dict[str, Any]:
    profile = result.profile_defaults()
    profile["name"] = profile_name
    profile["runtime"] = {
        "host": host,
        "port": port,
        "threads": "auto",
        "threads_batch": "auto",
    }
    profile["llama"] = {
        **profile.get("llama", {}),
        "gpu_layers": gpu_layers,
        "batch_size": 1024,
        "ubatch_size": 512,
        "use_mlock": True,
        "use_no_mmap": True,
        "direct_io": True,
    }
    profile["sampling"] = {
        "temp": 0.9,
        "top_p": 0.95,
        "top_k": 20,
        "min_p": 0.0,
        "presence_penalty": 1.5,
        "repeat_penalty": 1.0,
    }
    profile["template"] = {
        "enabled": bool(template),
        "path": template or None,
    }
    profile["server"] = {
        "cache_prompt": cache_prompt,
        "cache_reuse": cache_reuse,
        "slot_save_path": slot_save_path,
        "spec_type": spec_type,
        "spec_ngram_size_n": spec_ngram_size_n,
        "spec_ngram_size_m": spec_ngram_size_m,
        "perf": perf,
        "flash_attention": flash_attention,
        "no_cpu_moe": no_cpu_moe,
        "no_host": no_host,
        "extra_flags": extra_flags or [],
    }
    profile["secrets"] = {
        "required": [],
    }
    return profile


def model_profile_path(profile_name: str, output: str | None) -> Path:
    if output:
        path = Path(output).expanduser()
        if path.suffix:
            return path
        return path / f"{profile_name}.json"
    return resolve_paths().models_dir / f"{profile_name}.json"


def bool_env(value: Any) -> str:
    return "1" if bool(value) else "0"


def render_model_env(profile: dict[str, Any]) -> dict[str, str]:
    if isinstance(profile.get("env"), dict):
        return {str(key): str(value) for key, value in profile["env"].items()}
    runtime = profile.get("runtime") or {}
    llama = profile.get("llama") or {}
    sampling = profile.get("sampling") or {}
    template = profile.get("template") or {}
    server = profile.get("server") or {}
    rendered = {
        "MODEL_TYPE": str(profile.get("type", "llm")),
        "MODEL": str(profile.get("model_path", "")),
        "PORT": str(runtime.get("port", "")),
        "HOST": str(runtime.get("host", "")),
        "THREADS": str(runtime.get("threads", "auto")),
        "THREADS_BATCH": str(runtime.get("threads_batch", runtime.get("threads", "auto"))),
        "CTX_SIZE": str(llama.get("ctx_size") or ""),
        "GPU_LAYERS": str(llama.get("gpu_layers", "")),
        "BATCH_SIZE": str(llama.get("batch_size", "")),
        "UBATCH_SIZE": str(llama.get("ubatch_size", "")),
        "USE_MLOCK": bool_env(llama.get("use_mlock", False)),
        "USE_NO_MMAP": bool_env(llama.get("use_no_mmap", False)),
        "DIRECT_IO": bool_env(llama.get("direct_io", False)),
        "USE_CUSTOM_TEMPLATE": bool_env(template.get("enabled", False)),
        "CHAT_TEMPLATE": str(template.get("path") or ""),
        "CACHE_PROMPT": bool_env(server.get("cache_prompt", False)),
        "CACHE_REUSE": str(server.get("cache_reuse") or ""),
        "SLOT_SAVE_PATH": str(server.get("slot_save_path") or ""),
        "SPEC_TYPE": str(server.get("spec_type") or ""),
        "SPEC_NGRAM_SIZE_N": str(server.get("spec_ngram_size_n") or ""),
        "SPEC_NGRAM_SIZE_M": str(server.get("spec_ngram_size_m") or ""),
        "PERF": bool_env(server.get("perf", False)),
        "FLASH_ATTENTION": bool_env(server.get("flash_attention", False)),
        "NO_CPU_MOE": bool_env(server.get("no_cpu_moe", False)),
        "NO_HOST": bool_env(server.get("no_host", False)),
        "EXTRA_FLAGS": " ".join(str(flag) for flag in server.get("extra_flags", [])),
        "TEMP": str(sampling.get("temp", "")),
        "TOP_P": str(sampling.get("top_p", "")),
        "TOP_K": str(sampling.get("top_k", "")),
        "MIN_P": str(sampling.get("min_p", "")),
        "PRESENCE_PENALTY": str(sampling.get("presence_penalty", "")),
        "REPEAT_PENALTY": str(sampling.get("repeat_penalty", "")),
    }
    return {key: value for key, value in rendered.items() if value != ""}


def load_model_profile(profile_name: str, profile_path: str | None = None) -> tuple[Path, dict[str, Any]]:
    path = Path(profile_path).expanduser() if profile_path else resolve_paths().models_dir / f"{profile_name}.json"
    if not path.exists():
        raise AdminError(f"model profile not found: {path}")
    raw = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(raw, dict):
        raise AdminError(f"model profile must be a JSON object: {path}")
    return path, raw


def cmd_model_add(args: argparse.Namespace) -> int:
    result = read_gguf_metadata(Path(args.gguf))
    profile = build_model_profile(
        result,
        profile_name=args.name,
        host=args.host,
        port=args.port,
        gpu_layers=args.gpu_layers,
        template=args.template,
        cache_prompt=getattr(args, "cache_prompt", False),
        cache_reuse=getattr(args, "cache_reuse", None),
        slot_save_path=getattr(args, "slot_save_path", None),
        spec_type=getattr(args, "spec_type", None),
        spec_ngram_size_n=getattr(args, "spec_ngram_size_n", None),
        spec_ngram_size_m=getattr(args, "spec_ngram_size_m", None),
        perf=getattr(args, "perf", False),
        flash_attention=getattr(args, "flash_attention", False),
        no_cpu_moe=getattr(args, "no_cpu_moe", False),
        no_host=getattr(args, "no_host", False),
        extra_flags=getattr(args, "extra_flag", []),
    )
    destination = model_profile_path(args.name, args.output)
    print(f"model_profile={args.name}")
    print(f"model_path={result.path}")
    print(f"destination={destination}")
    print(f"mode={'dry-run' if args.dry_run else 'write'}")
    if args.dry_run:
        print(json.dumps(profile, indent=2, sort_keys=True))
        print("dry-run: no files written")
        return 0
    write_json_document(destination, profile, force=args.force)
    print(f"wrote {destination}")
    return 0


def cmd_model_render_env(args: argparse.Namespace) -> int:
    profile_path, profile = load_model_profile(args.name, args.profile_path)
    rendered = render_model_env(profile)
    if args.json:
        print(json.dumps({"profile": str(profile_path), "env": rendered}, indent=2, sort_keys=True))
        return 0
    for key in sorted(rendered):
        print(f"{key}={shlex.quote(rendered[key])}")
    return 0


REQUIRED_MODEL_ENV = (
    "MODEL_TYPE",
    "MODEL",
    "PORT",
    "HOST",
    "THREADS",
    "THREADS_BATCH",
    "CTX_SIZE",
    "GPU_LAYERS",
    "BATCH_SIZE",
    "UBATCH_SIZE",
)


def model_launch_command(env: dict[str, str]) -> list[str]:
    model_type = env.get("MODEL_TYPE", "")
    if model_type in {"llm", "embedding"}:
        command = [
            "llama-server",
            "--model",
            env.get("MODEL", ""),
            "--host",
            env.get("HOST", ""),
            "--port",
            env.get("PORT", ""),
            "--ctx-size",
            env.get("CTX_SIZE", ""),
        ]
        if model_type == "embedding":
            command.append("--embedding")
        if env.get("CACHE_PROMPT") == "1":
            command.append("--cache-prompt")
        if env.get("CACHE_REUSE"):
            command.extend(["--cache-reuse", env["CACHE_REUSE"]])
        if env.get("SLOT_SAVE_PATH"):
            command.extend(["--slot-save-path", env["SLOT_SAVE_PATH"]])
        if env.get("SPEC_TYPE"):
            command.extend(["--spec-type", env["SPEC_TYPE"]])
        if env.get("SPEC_NGRAM_SIZE_N"):
            command.extend(["--spec-ngram-size-n", env["SPEC_NGRAM_SIZE_N"]])
        if env.get("SPEC_NGRAM_SIZE_M"):
            command.extend(["--spec-ngram-size-m", env["SPEC_NGRAM_SIZE_M"]])
        if env.get("PERF") == "1":
            command.append("--perf")
        if env.get("FLASH_ATTENTION") == "1":
            command.append("--fa")
        if env.get("NO_CPU_MOE") == "1":
            command.append("--no-cpu-moe")
        if env.get("NO_HOST") == "1":
            command.append("--no-host")
        if env.get("EXTRA_FLAGS"):
            command.extend(shlex.split(env["EXTRA_FLAGS"]))
        return command
    if model_type == "tts":
        return ["python", "-m", "mlx_audio.server", "--model", env.get("MODEL", "")]
    return []


def cmd_model_simulate(args: argparse.Namespace) -> int:
    profile_path, profile = load_model_profile(args.name, args.profile_path)
    env = render_model_env(profile)
    missing = [key for key in REQUIRED_MODEL_ENV if not env.get(key)]
    print(f"simulation=model")
    print(f"profile={profile_path}")
    print(f"action={args.action}")
    if missing:
        print(f"status=invalid")
        print(f"missing={','.join(missing)}")
        return 2
    print("status=ok")
    if args.action == "start":
        print("would_launch=" + " ".join(shlex.quote(part) for part in model_launch_command(env)))
    elif args.action == "status":
        print(f"would_check_pid=modelctl-{args.name}")
        print(f"would_probe=http://{env['HOST']}:{env['PORT']}/v1/models")
    elif args.action == "stop":
        print(f"would_stop_pid=modelctl-{args.name}")
    return 0


REQUIRED_STRUCTURED_MODEL_KEYS = {
    "root": ("schema_version", "name", "type", "model_path", "runtime", "llama", "sampling", "template", "server", "secrets"),
    "runtime": ("host", "port", "threads", "threads_batch"),
    "llama": (
        "ctx_size",
        "gpu_layers",
        "batch_size",
        "ubatch_size",
        "use_mlock",
        "use_no_mmap",
        "direct_io",
    ),
    "server": (
        "cache_prompt",
        "cache_reuse",
        "slot_save_path",
        "spec_type",
        "spec_ngram_size_n",
        "spec_ngram_size_m",
        "perf",
        "flash_attention",
        "no_cpu_moe",
        "no_host",
        "extra_flags",
    ),
}


def missing_profile_keys(profile: dict[str, Any]) -> list[str]:
    if isinstance(profile.get("env"), dict):
        return []
    missing: list[str] = []
    for key in REQUIRED_STRUCTURED_MODEL_KEYS["root"]:
        if key not in profile:
            missing.append(key)
    for section in ("runtime", "llama", "server"):
        value = profile.get(section)
        if not isinstance(value, dict):
            continue
        for key in REQUIRED_STRUCTURED_MODEL_KEYS[section]:
            if key not in value:
                missing.append(f"{section}.{key}")
    return missing


def cmd_model_profile_doctor(args: argparse.Namespace) -> int:
    profile_path, profile = load_model_profile(args.name, args.profile_path)
    missing = missing_profile_keys(profile)
    print(f"profile={profile_path}")
    if missing:
        location = "remote" if args.remote else "local"
        print(f"status=missing-parameters")
        print(f"location={location}")
        for key in missing:
            print(f"missing={key}")
        return 1
    print("status=ok")
    return 0


def agent_profile_candidates(name: str, profile_path: str | None = None) -> list[Path]:
    if profile_path:
        return [Path(profile_path).expanduser()]
    return [
        resolve_paths().agents_dir / f"{name}.json",
        REPO_ROOT / "scripts" / "agents" / f"{name}.env",
    ]


def load_agent_profile(name: str, profile_path: str | None = None) -> tuple[Path, dict[str, Any]]:
    candidates = agent_profile_candidates(name, profile_path)
    for path in candidates:
        if not path.exists():
            continue
        if path.suffix == ".json":
            raw = json.loads(path.read_text(encoding="utf-8"))
            if not isinstance(raw, dict):
                raise AdminError(f"agent profile must be a JSON object: {path}")
            return path, {str(key): value for key, value in raw.items()}
        return path, {
            "schema_version": 1,
            "name": name,
            "env": parse_legacy_assignment_file(path),
            "sources": [source_record("repo agent profile", path)],
        }
    raise AdminError(f"agent profile not found: {candidates[0]}")


def render_agent_env(profile: dict[str, Any]) -> dict[str, str]:
    if isinstance(profile.get("env"), dict):
        return {str(key): str(value) for key, value in profile["env"].items()}
    runtime = profile.get("runtime") or {}
    secrets = profile.get("secrets") or {}
    rendered: dict[str, str] = {}
    for key, value in runtime.items():
        rendered[str(key).upper()] = str(value)
    if secrets:
        rendered["LLMOPS_USE_SECKIT"] = bool_env(secrets.get("provider") == "seckit")
        if secrets.get("service"):
            rendered["LLMOPS_SECKIT_SERVICE"] = str(secrets["service"])
        if secrets.get("account"):
            rendered["LLMOPS_SECKIT_ACCOUNT"] = str(secrets["account"])
        names = secrets.get("names") or []
        if names:
            rendered["LLMOPS_AGENT_SECKIT_NAMES"] = ",".join(str(name) for name in names)
    return rendered


def load_service_profile(name: str, profile_path: str | None = None) -> tuple[Path, dict[str, Any]]:
    path = Path(profile_path).expanduser() if profile_path else resolve_paths().services_dir / f"{name}.json"
    if not path.exists():
        raise AdminError(f"service profile not found: {path}")
    raw = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(raw, dict):
        raise AdminError(f"service profile must be a JSON object: {path}")
    return path, raw


def render_model_proxy_env(profile: dict[str, Any]) -> dict[str, str]:
    runtime = profile.get("runtime") or {}
    logging = profile.get("logging") or {}
    template = profile.get("template") or {}
    rendered = {
        "LLMOPS_UPSTREAM_HOST": runtime.get("upstream_host"),
        "LLMOPS_UPSTREAM_PORT": runtime.get("upstream_port"),
        "MODEL_PROXY_LISTEN_HOST": runtime.get("listen_host"),
        "MODEL_PROXY_LISTEN_PORT": runtime.get("listen_port"),
        "MODEL_PROXY_PYTHON_BIN": runtime.get("python_bin"),
        "MODEL_PROXY_CHAT_TEMPLATE": template.get("path"),
        "MODEL_PROXY_LOG_ROTATE_SECONDS": logging.get("rotate_seconds"),
        "MODEL_PROXY_LOG_ROTATE_KEEP": logging.get("rotate_keep"),
    }
    return {key: str(value) for key, value in rendered.items() if value not in (None, "")}


def render_tts_bridge_env(profile: dict[str, Any]) -> dict[str, str]:
    runtime = profile.get("runtime") or {}
    paths = profile.get("paths") or {}
    logging = profile.get("logging") or {}
    defaults = profile.get("defaults") or {}
    rendered = {
        "TTS_BRIDGE_HOST": runtime.get("host"),
        "TTS_BRIDGE_PORT": runtime.get("port"),
        "TTS_BRIDGE_UPSTREAM_BASE": runtime.get("upstream_base"),
        "TTS_BRIDGE_MODEL": paths.get("model"),
        "TTS_BRIDGE_CONFIG_DIR": paths.get("config_dir"),
        "TTS_BRIDGE_PRONOUNCE_CONFIG": paths.get("pronounce_config"),
        "TTS_BRIDGE_VOICE_MAP_CONFIG": paths.get("voice_map_config"),
        "TTS_BRIDGE_SAMPLES_DIR": paths.get("samples_dir"),
        "TTS_BRIDGE_LOG_ROTATE_SECONDS": logging.get("rotate_seconds"),
        "TTS_BRIDGE_LOG_ROTATE_KEEP": logging.get("rotate_keep"),
        "TTS_BRIDGE_REF_AUDIO": defaults.get("ref_audio"),
        "TTS_BRIDGE_REF_TEXT": defaults.get("ref_text"),
        "TTS_BRIDGE_PYTHON_BIN": runtime.get("python_bin"),
    }
    return {key: str(value) for key, value in rendered.items() if value not in (None, "")}


def render_service_env(name: str, profile: dict[str, Any]) -> dict[str, str]:
    if isinstance(profile.get("env"), dict):
        return {str(key): str(value) for key, value in profile["env"].items()}
    if name == "model-proxy":
        return render_model_proxy_env(profile)
    if name == "tts-bridge":
        return render_tts_bridge_env(profile)
    raise AdminError(f"unsupported service profile: {name}")


def cmd_service_render_env(args: argparse.Namespace) -> int:
    profile_path, profile = load_service_profile(args.name, args.profile_path)
    rendered = render_service_env(args.name, profile)
    if args.json:
        print(json.dumps({"profile": str(profile_path), "env": rendered}, indent=2, sort_keys=True))
        return 0
    for key in sorted(rendered):
        print(f"{key}={shlex.quote(rendered[key])}")
    return 0


def agent_launch_command(name: str, env: dict[str, str]) -> list[str]:
    if name == "openclaw":
        cmd = env.get("OPENCLAW_GATEWAY_CMD", "openclaw")
        port = env.get("LLMOPS_GATEWAY_PORT", "18789")
        return [cmd, "gateway", "run", "--port", port]
    if name == "hermes":
        cmd = env.get("HERMES_GATEWAY_CMD", "hermes")
        args = shlex.split(env.get("HERMES_GATEWAY_ARGS", ""))
        return [cmd, "gateway", *args]
    return [name]


def cmd_agent_simulate(args: argparse.Namespace) -> int:
    profile_path, profile = load_agent_profile(args.name, args.profile_path)
    env = render_agent_env(profile)
    print("simulation=agent")
    print(f"profile={profile_path}")
    print(f"backend={args.name}")
    print(f"action={args.action}")
    print("status=ok")
    if args.action == "start":
        print("would_launch=" + " ".join(shlex.quote(part) for part in agent_launch_command(args.name, env)))
    elif args.action == "status":
        print(f"would_check_pid=agentctl-{args.name}")
        if args.name == "openclaw":
            print(f"would_probe=http://127.0.0.1:{env.get('LLMOPS_GATEWAY_PORT', '18789')}/health")
    elif args.action == "stop":
        print(f"would_stop_pid=agentctl-{args.name}")
    return 0


def cmd_agent_render_env(args: argparse.Namespace) -> int:
    profile_path, profile = load_agent_profile(args.name, args.profile_path)
    rendered = render_agent_env(profile)
    if args.json:
        print(json.dumps({"profile": str(profile_path), "env": rendered}, indent=2, sort_keys=True))
        return 0
    for key in sorted(rendered):
        print(f"{key}={shlex.quote(rendered[key])}")
    return 0


def cmd_deploy_plan(args: argparse.Namespace) -> int:
    hosts = select_hosts(load_inventory(inventory_path(args)), args)
    bundle_id = args.bundle_id or "<generated-timestamp>"
    stage_root = Path(args.stage_root).expanduser()
    stage_dir = stage_root / bundle_id
    print("simulation=deploy")
    print(f"mode={'dry-run' if args.dry_run else 'plan'}")
    print(f"inventory={inventory_path(args)}")
    print(f"stage_dir={stage_dir}")
    print(f"package={stage_dir / 'package' / 'llm-ops-kit.tar.gz'}")
    print(f"selected_hosts={len(hosts)}")
    for host in hosts:
        remote_package_dir = f"{host.install_root}/packages/{bundle_id}"
        release_dir = f"{host.install_root}/releases/{bundle_id}"
        print(
            "host"
            f"\tname={host.name}"
            f"\trole={host.role}"
            f"\tdestination={host.destination}"
            f"\tssh_port={host.port}"
            f"\tproxy_jump={host.proxy_jump or ''}"
            f"\tprofile={host.config_profile}"
            f"\tinstall_root={host.install_root}"
            f"\tremote_package_dir={remote_package_dir}"
            f"\tremote_package={remote_package_dir}/llm-ops-kit.tar.gz"
            f"\tremote_manifest={remote_package_dir}/manifest.json"
            f"\trelease_dir={release_dir}"
            f"\trelease_manifest={release_dir}/manifest.json"
            f"\trelease_config_dir={release_dir}/config"
            f"\tremote_config_env={host.install_root}/config/{host.name}.env"
            f"\tremote_config_json={host.install_root}/config/{host.name}.json"
            f"\tremote_config_sources={host.install_root}/config/{host.name}.sources.json"
            f"\tconfig_env={stage_dir / 'hosts' / host.name / 'config.env'}"
            f"\tconfig_json={stage_dir / 'hosts' / host.name / 'config.json'}"
            f"\tconfig_sources={stage_dir / 'hosts' / host.name / 'config-sources.json'}"
        )
    print("dry-run: no package built, no files written, no SSH attempted")
    return 0


def add_host_selectors(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--inventory")
    parser.add_argument("--role", choices=sorted(SUPPORTED_ROLES))
    parser.add_argument("--tag", action="append")
    parser.add_argument("--host-name", action="append")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="LLM-Ops-Kit administrator deployment workflow")
    sub = parser.add_subparsers(dest="command", required=True)
    inv = sub.add_parser("inventory-validate")
    add_host_selectors(inv)
    inv.set_defaults(func=cmd_inventory_validate)
    boot = sub.add_parser("bootstrap-host")
    add_host_selectors(boot)
    boot.add_argument("--dry-run", action="store_true")
    boot.set_defaults(func=cmd_bootstrap_host)
    stage = sub.add_parser("stage")
    add_host_selectors(stage)
    stage.add_argument("--stage-root", default=str(DEFAULT_STAGE_ROOT))
    stage.add_argument("--bundle-id")
    stage.add_argument("--model")
    stage.add_argument("--dry-run", action="store_true")
    stage.set_defaults(func=cmd_stage)
    push = sub.add_parser("push")
    add_host_selectors(push)
    push.add_argument("--stage-root", default=str(DEFAULT_STAGE_ROOT))
    push.add_argument("--stage")
    push.add_argument("--workers", type=int, default=4)
    push.add_argument("--dry-run", action="store_true")
    push.set_defaults(func=cmd_push)
    apply = sub.add_parser("apply")
    add_host_selectors(apply)
    apply.add_argument("--stage-root", default=str(DEFAULT_STAGE_ROOT))
    apply.add_argument("--stage")
    apply.add_argument("--workers", type=int, default=4)
    apply.add_argument("--restart")
    apply.add_argument("--dry-run", action="store_true")
    apply.set_defaults(func=cmd_apply)
    stage_validate = sub.add_parser("stage-validate")
    add_host_selectors(stage_validate)
    stage_validate.add_argument("--stage-root", default=str(DEFAULT_STAGE_ROOT))
    stage_validate.add_argument("--stage")
    stage_validate.add_argument("--no-package", action="store_true")
    stage_validate.set_defaults(func=cmd_stage_validate)
    deploy_report = sub.add_parser("deploy-report")
    add_host_selectors(deploy_report)
    deploy_report.add_argument("--stage-root", default=str(DEFAULT_STAGE_ROOT))
    deploy_report.add_argument("--stage")
    deploy_report.add_argument("--no-package", action="store_true")
    deploy_report.set_defaults(func=cmd_deploy_report)
    settings = sub.add_parser("config-settings")
    add_host_selectors(settings)
    settings.add_argument("--model")
    settings.set_defaults(func=cmd_config_settings)
    doctor = sub.add_parser("config-doctor")
    add_host_selectors(doctor)
    doctor.add_argument("--model")
    doctor.add_argument("--dry-run", action="store_true")
    doctor.set_defaults(func=cmd_config_doctor)
    migrate = sub.add_parser("migrate-config")
    migrate.add_argument("--legacy-home", default="~/.llm-ops")
    migrate.add_argument("--output")
    migrate.add_argument("--dry-run", action="store_true")
    migrate.add_argument("--force", action="store_true")
    migrate.set_defaults(func=cmd_migrate_config)
    inspect = sub.add_parser("model-inspect")
    inspect.add_argument("gguf")
    inspect.add_argument("--json", action="store_true")
    inspect.add_argument("--no-cache", action="store_true")
    inspect.set_defaults(func=cmd_model_inspect)
    model_add = sub.add_parser("model-add")
    model_add.add_argument("name")
    model_add.add_argument("--gguf", required=True)
    model_add.add_argument("--output")
    model_add.add_argument("--host", default="0.0.0.0")
    model_add.add_argument("--port", type=int, default=11434)
    model_add.add_argument("--gpu-layers", default="auto")
    model_add.add_argument("--template", default="")
    model_add.add_argument("--cache-prompt", action="store_true")
    model_add.add_argument("--cache-reuse", type=int)
    model_add.add_argument("--slot-save-path")
    model_add.add_argument("--spec-type")
    model_add.add_argument("--spec-ngram-size-n", type=int)
    model_add.add_argument("--spec-ngram-size-m", type=int)
    model_add.add_argument("--perf", action="store_true")
    model_add.add_argument("--fa", dest="flash_attention", action="store_true")
    model_add.add_argument("--no-cpu-moe", action="store_true")
    model_add.add_argument("--no-host", action="store_true")
    model_add.add_argument("--extra-flag", action="append", default=[])
    model_add.add_argument("--dry-run", action="store_true")
    model_add.add_argument("--force", action="store_true")
    model_add.set_defaults(func=cmd_model_add)
    render_env = sub.add_parser("model-render-env")
    render_env.add_argument("name")
    render_env.add_argument("--profile-path")
    render_env.add_argument("--json", action="store_true")
    render_env.set_defaults(func=cmd_model_render_env)
    model_sim = sub.add_parser("model-simulate")
    model_sim.add_argument("name")
    model_sim.add_argument("--profile-path")
    model_sim.add_argument("--action", choices=("start", "status", "stop"), default="start")
    model_sim.set_defaults(func=cmd_model_simulate)
    profile_doctor = sub.add_parser("model-profile-doctor")
    profile_doctor.add_argument("name")
    profile_doctor.add_argument("--profile-path")
    profile_doctor.add_argument("--remote", action="store_true")
    profile_doctor.set_defaults(func=cmd_model_profile_doctor)
    agent_sim = sub.add_parser("agent-simulate")
    agent_sim.add_argument("name", choices=("openclaw", "hermes"))
    agent_sim.add_argument("--profile-path")
    agent_sim.add_argument("--action", choices=("start", "status", "stop"), default="start")
    agent_sim.set_defaults(func=cmd_agent_simulate)
    agent_env = sub.add_parser("agent-render-env")
    agent_env.add_argument("name", choices=("openclaw", "hermes"))
    agent_env.add_argument("--profile-path")
    agent_env.add_argument("--json", action="store_true")
    agent_env.set_defaults(func=cmd_agent_render_env)
    service_env = sub.add_parser("service-render-env")
    service_env.add_argument("name", choices=("model-proxy", "tts-bridge"))
    service_env.add_argument("--profile-path")
    service_env.add_argument("--json", action="store_true")
    service_env.set_defaults(func=cmd_service_render_env)
    deploy_plan = sub.add_parser("deploy-plan")
    add_host_selectors(deploy_plan)
    deploy_plan.add_argument("--stage-root", default=str(DEFAULT_STAGE_ROOT))
    deploy_plan.add_argument("--bundle-id")
    deploy_plan.add_argument("--dry-run", action="store_true")
    deploy_plan.set_defaults(func=cmd_deploy_plan)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except (AdminError, ConfigError, GgufError) as exc:
        print(f"llmops-admin: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
