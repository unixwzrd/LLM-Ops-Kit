# Hermes backend defaults for agentctl.
# Copy to ~/.llm-ops/config/agents/hermes.env to customize locally.

HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
HERMES_GATEWAY_CMD="${HERMES_GATEWAY_CMD:-hermes}"
LLMOPS_AGENT_SHELL_INIT_FILE="${LLMOPS_AGENT_SHELL_INIT_FILE:-$HOME/.bashrc}"
LLMOPS_AGENT_NATIVE_ENV_FILE="${LLMOPS_AGENT_NATIVE_ENV_FILE:-}"
LLMOPS_USE_SECKIT="${LLMOPS_USE_SECKIT:-0}"
LLMOPS_SECKIT_SERVICE="${LLMOPS_SECKIT_SERVICE:-hermes}"
LLMOPS_SECKIT_ACCOUNT="${LLMOPS_SECKIT_ACCOUNT:-default}"
LLMOPS_AGENT_SECKIT_NAMES="${LLMOPS_AGENT_SECKIT_NAMES:-TELEGRAM_BOT_TOKEN,VOICE_TOOLS_OPENAI_KEY,OPENAI_API_KEY,BRAVE_SEARCH_API_KEY,ELEVENLABS_API_KEY}"
HERMES_USE_SECKIT="${HERMES_USE_SECKIT:-0}"
HERMES_SECKIT_SERVICE="${HERMES_SECKIT_SERVICE:-hermes}"
HERMES_SECKIT_ACCOUNT="${HERMES_SECKIT_ACCOUNT:-default}"
HERMES_SECKIT_NAMES="${HERMES_SECKIT_NAMES:-$LLMOPS_AGENT_SECKIT_NAMES}"
# Hermes still reads ~/.hermes/.env; keep it placeholder-only.
HERMES_SKIP_DOTENV="${HERMES_SKIP_DOTENV:-1}"
HERMES_GATEWAY_ARGS="${HERMES_GATEWAY_ARGS:---replace}"
