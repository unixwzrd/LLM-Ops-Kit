#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/common.sh"

CONFIG_NAME="${LLMOPS_DEPLOY_CONFIG_NAME:-default}"
CONFIG_FILE=""
RESET=0
PRINT_TEMPLATE=0

usage() {
  cat <<USAGE
Usage: $(basename "$0") [options]

Options:
  --config-name <name>  Deployment config name (default: default)
  --config-file <path>  Explicit deployment config file path
  --reset               Re-prompt values using existing config as defaults
  --print-template      Print a commented template and exit
  -h, --help            Show this help
USAGE
}

emit_var() {
  local key="$1"
  local value="$2"
  printf '%s=%q\n' "$key" "$value"
}

default_base_dir_for_user() {
  local user_name="$1"
  case "$(uname -s 2>/dev/null || printf unknown)" in
    Darwin) printf '/Users/%s\n' "$user_name" ;;
    *) printf '/home/%s\n' "$user_name" ;;
  esac
}

default_install_prefix() {
  local base_dir="$1"
  printf '%s/.llm-ops\n' "$base_dir"
}

default_bin_dir() {
  local base_dir="$1"
  printf '%s/bin\n' "$base_dir"
}

default_state_file() {
  local install_prefix="$1"
  printf '%s/runtime-state.env\n' "$install_prefix"
}

default_venv_path() {
  local install_prefix="$1"
  printf '%s/venv\n' "$install_prefix"
}

print_template() {
  cat <<'EOF'
# LLM-Ops-Kit deployment config
# This file stays local under stage/deploy_config/ and is never synced.
#
# LLMOPS_DEPLOY_CONFIG_NAME="default"
# LLMOPS_DEPLOY_HOSTS="host-a host-b"
# LLMOPS_DEPLOY_USER="operator"
# LLMOPS_DEPLOY_BASE_DIR="/Users/operator"
# LLMOPS_DEPLOY_INSTALL_PREFIX="/Users/operator/.llm-ops"
# LLMOPS_DEPLOY_BIN_DIR="/Users/operator/bin"
# LLMOPS_DEPLOY_STATE_FILE="/Users/operator/.llm-ops/runtime-state.env"
# LLMOPS_DEPLOY_VENV_PATH="/Users/operator/.llm-ops/venv"
# LLMOPS_DEPLOY_INSTALL_SECRETS_KIT="0"
# LLMOPS_DEPLOY_SECRETS_KIT_SOURCE="git+https://github.com/unixwzrd/Secrets-Kit.git"
# LLMOPS_DEPLOY_SSH_KEY_PATH=""
EOF
}

prompt_value() {
  local label="$1"
  local current="$2"
  local answer=""
  if [[ -n "$current" ]]; then
    printf '%s [%s]: ' "$label" "$current" >&2
  else
    printf '%s: ' "$label" >&2
  fi
  if ! IFS= read -r answer; then
    answer=""
  fi
  if [[ -z "$answer" ]]; then
    printf '%s\n' "$current"
  else
    printf '%s\n' "$answer"
  fi
}

prompt_toggle() {
  local label="$1"
  local current="$2"
  if [[ "$current" == "1" ]]; then
    if prompt_yes_no "$label" "Y"; then
      printf '1\n'
    else
      printf '0\n'
    fi
  else
    if prompt_yes_no "$label" "N"; then
      printf '1\n'
    else
      printf '0\n'
    fi
  fi
}

prompt_host_action() {
  local existing="$1"
  local answer=""
  if [[ -n "$existing" ]]; then
    printf 'Current hosts: %s\n' "$existing" >&2
    printf 'Keep existing hosts, add more, or replace them? [k/a/r]: ' >&2
    if ! IFS= read -r answer; then
      answer=""
    fi
    answer="$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')"
    case "$answer" in
      a|add) printf 'add\n' ;;
      r|replace|restart) printf 'replace\n' ;;
      ""|k|keep) printf 'keep\n' ;;
      *) printf 'keep\n' ;;
    esac
  else
    printf 'replace\n'
  fi
}

prompt_hosts() {
  local existing="$1"
  local mode line combined
  mode="$(prompt_host_action "$existing")"
  case "$mode" in
    keep)
      printf '%s\n' "$existing"
      return 0
      ;;
    add)
      combined="$existing"
      ;;
    replace)
      combined=""
      ;;
  esac

  while true; do
    printf 'What host will you deploy on? [blank when done]: ' >&2
    if ! IFS= read -r line; then
      line=""
    fi
    [[ -n "$line" ]] || break
    combined="$(deploy_host_list_normalize "$combined $line")"
  done
  printf '%s\n' "$combined"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --config-name) CONFIG_NAME="$2"; shift 2 ;;
    --config-file) CONFIG_FILE="$2"; shift 2 ;;
    --reset) RESET=1; shift ;;
    --print-template) PRINT_TEMPLATE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ "$PRINT_TEMPLATE" -eq 1 ]]; then
  print_template
  exit 0
fi

if [[ -z "$CONFIG_FILE" ]]; then
  CONFIG_FILE="$(deploy_config_path "$CONFIG_NAME")"
else
  CONFIG_NAME="${CONFIG_NAME:-$(basename "$CONFIG_FILE" .env)}"
fi

if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
fi

CONFIG_NAME="${LLMOPS_DEPLOY_CONFIG_NAME:-$CONFIG_NAME}"
if [[ ! "$CONFIG_NAME" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Invalid config name: $CONFIG_NAME" >&2
  exit 2
fi

USER_NAME="${LLMOPS_DEPLOY_USER:-$USER}"
BASE_DIR="${LLMOPS_DEPLOY_BASE_DIR:-$(default_base_dir_for_user "$USER_NAME")}"
INSTALL_PREFIX="${LLMOPS_DEPLOY_INSTALL_PREFIX:-$(default_install_prefix "$BASE_DIR")}"
BIN_DIR="${LLMOPS_DEPLOY_BIN_DIR:-$(default_bin_dir "$BASE_DIR")}"
STATE_FILE="${LLMOPS_DEPLOY_STATE_FILE:-$(default_state_file "$INSTALL_PREFIX")}"
VENV_PATH="${LLMOPS_DEPLOY_VENV_PATH:-$(default_venv_path "$INSTALL_PREFIX")}"
HOSTS="$(deploy_host_list_normalize "${LLMOPS_DEPLOY_HOSTS:-}")"
INSTALL_SECRETS_KIT="${LLMOPS_DEPLOY_INSTALL_SECRETS_KIT:-0}"
SECRETS_KIT_SOURCE="${LLMOPS_DEPLOY_SECRETS_KIT_SOURCE:-git+https://github.com/unixwzrd/Secrets-Kit.git}"
SSH_KEY_PATH="${LLMOPS_DEPLOY_SSH_KEY_PATH:-}"

if [[ "$RESET" -eq 1 || ! -f "$CONFIG_FILE" ]]; then
  old_user="$USER_NAME"
  old_base="$BASE_DIR"
  old_install="$INSTALL_PREFIX"
  HOSTS="$(prompt_hosts "$HOSTS")"
  if [[ -z "$HOSTS" ]]; then
    echo "At least one host is required." >&2
    exit 1
  fi
  USER_NAME="$(prompt_value "What user will own the runtime?" "$USER_NAME")"
  if [[ -z "$BASE_DIR" || "$BASE_DIR" == "$(default_base_dir_for_user "$old_user")" ]]; then
    BASE_DIR="$(default_base_dir_for_user "$USER_NAME")"
  fi
  BASE_DIR="$(prompt_value "What base directory should own this runtime?" "$BASE_DIR")"
  if [[ -z "$INSTALL_PREFIX" || "$INSTALL_PREFIX" == "$(default_install_prefix "$old_base")" ]]; then
    INSTALL_PREFIX="$(default_install_prefix "$BASE_DIR")"
  fi
  INSTALL_PREFIX="$(prompt_value "Where should the runtime install root live?" "$INSTALL_PREFIX")"
  if [[ -z "$BIN_DIR" || "$BIN_DIR" == "$(default_bin_dir "$old_base")" ]]; then
    BIN_DIR="$(default_bin_dir "$BASE_DIR")"
  fi
  BIN_DIR="$(prompt_value "Where should managed executables be linked?" "$BIN_DIR")"
  if [[ -z "$STATE_FILE" || "$STATE_FILE" == "$(default_state_file "$old_install")" ]]; then
    STATE_FILE="$(default_state_file "$INSTALL_PREFIX")"
  fi
  STATE_FILE="$(prompt_value "Where should the runtime state file live?" "$STATE_FILE")"
  if [[ -z "$VENV_PATH" || "$VENV_PATH" == "$(default_venv_path "$old_install")" ]]; then
    VENV_PATH="$(default_venv_path "$INSTALL_PREFIX")"
  fi
  VENV_PATH="$(prompt_value "Where should the runtime Python virtualenv live?" "$VENV_PATH")"
  INSTALL_SECRETS_KIT="$(prompt_toggle "Install Secrets-Kit into the runtime venv?" "$INSTALL_SECRETS_KIT")"
  if [[ "$INSTALL_SECRETS_KIT" == "1" ]]; then
    SECRETS_KIT_SOURCE="$(prompt_value "Secrets-Kit install source" "$SECRETS_KIT_SOURCE")"
  fi
  SSH_KEY_PATH="$(prompt_value "SSH key path, blank uses normal ssh config" "$SSH_KEY_PATH")"
fi

HOSTS="$(deploy_host_list_normalize "$HOSTS")"
if [[ -z "$HOSTS" ]]; then
  echo "At least one host is required." >&2
  exit 1
fi

mkdir -p "$(dirname "$CONFIG_FILE")"
TMP_FILE="${CONFIG_FILE}.tmp.$$"
{
  echo "# LLM-Ops-Kit deployment config"
  echo "# Local-only operator config generated by setup-deploy."
  echo
  emit_var "LLMOPS_DEPLOY_CONFIG_NAME" "$CONFIG_NAME"
  emit_var "LLMOPS_DEPLOY_HOSTS" "$HOSTS"
  emit_var "LLMOPS_DEPLOY_USER" "$USER_NAME"
  emit_var "LLMOPS_DEPLOY_BASE_DIR" "$BASE_DIR"
  emit_var "LLMOPS_DEPLOY_INSTALL_PREFIX" "$INSTALL_PREFIX"
  emit_var "LLMOPS_DEPLOY_BIN_DIR" "$BIN_DIR"
  emit_var "LLMOPS_DEPLOY_STATE_FILE" "$STATE_FILE"
  emit_var "LLMOPS_DEPLOY_VENV_PATH" "$VENV_PATH"
  emit_var "LLMOPS_DEPLOY_INSTALL_SECRETS_KIT" "$INSTALL_SECRETS_KIT"
  emit_var "LLMOPS_DEPLOY_SECRETS_KIT_SOURCE" "$SECRETS_KIT_SOURCE"
  emit_var "LLMOPS_DEPLOY_SSH_KEY_PATH" "$SSH_KEY_PATH"
} > "$TMP_FILE"

mv "$TMP_FILE" "$CONFIG_FILE"
echo "WROTE_DEPLOY_CONFIG: $CONFIG_FILE"
echo "ACTIVE_CONFIG: $CONFIG_NAME"
echo "DEPLOY_HOSTS: $HOSTS"
