#!/usr/bin/env bash
set -euo pipefail

RELEASE_CHECK=0
if [[ "${1:-}" == "--release" ]]; then
  RELEASE_CHECK=1
  shift
fi
[[ $# -eq 0 ]] || { echo "usage: precheck [--release]" >&2; exit 2; }

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
REPO_ROOT="$(cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python}"

cd "$REPO_ROOT"

command -v "$PYTHON_BIN" >/dev/null 2>&1 || {
  echo "precheck: Python interpreter not found: $PYTHON_BIN" >&2
  exit 2
}
PYTHON_PATH="$("$PYTHON_BIN" -c 'import sys; print(sys.executable)')"
PYTHON_VERSION="$("$PYTHON_BIN" --version 2>&1)"
if [[ -n "${CONDA_PREFIX:-}" && "$PYTHON_PATH" != "$CONDA_PREFIX"/* ]]; then
  echo "precheck: selected Python is outside active Conda environment: $PYTHON_PATH" >&2
  echo "precheck: expected an interpreter under $CONDA_PREFIX" >&2
  exit 2
fi
if [[ -n "${VIRTUAL_ENV:-}" && "$PYTHON_PATH" != "$VIRTUAL_ENV"/* ]]; then
  echo "precheck: selected Python is outside active virtual environment: $PYTHON_PATH" >&2
  echo "precheck: expected an interpreter under $VIRTUAL_ENV" >&2
  exit 2
fi
printf '==> Python interpreter: %s (%s)\n' "$PYTHON_PATH" "$PYTHON_VERSION"

shell_targets=(
  "scripts/lib/common.sh"
  "scripts/llmops"
  "scripts/modelctl"
  "scripts/tts-bridge"
  "scripts/model-proxy"
  "scripts/install-runtime.sh"
  "scripts/bootstrap-install.sh"
  "scripts/uninstall-runtime.sh"
)

python_targets=(
  "scripts/llmops-control"
  "scripts/build-release.py"
  "src/llmops_kit/llmops_config.py"
  "src/llmops_kit/llmops_config_sync.py"
  "src/llmops_kit/llmops_drivers.py"
  "src/llmops_kit/llmops_executor.py"
  "src/llmops_kit/llmops_inventory.py"
  "src/llmops_kit/llmops_init.py"
  "src/llmops_kit/llmops_install_state.py"
  "src/llmops_kit/llmops_migration.py"
  "src/llmops_kit/llmops_paths.py"
  "src/llmops_kit/llmops_probe.py"
  "src/llmops_kit/llmops_profiles.py"
  "src/llmops_kit/llmops_topology.py"
  "src/llmops_kit/llmops_update.py"
  "src/llmops_kit/llmops_adapters.py"
  "src/llmops_kit/llmops_cli.py"
  "src/llmops_kit/llmops_tui.py"
  "src/llmops_kit/entrypoint.py"
  "src/llmops_kit/__init__.py"
)

echo "==> Shell syntax checks"
bash -n "${shell_targets[@]}"

if ! command -v shellcheck >/dev/null 2>&1; then
  echo "precheck: shellcheck is required but was not found in PATH" >&2
  exit 2
fi

echo "==> Shellcheck"
shellcheck "${shell_targets[@]}"

echo "==> Python compile checks"
"$PYTHON_BIN" -m py_compile "${python_targets[@]}"

echo "==> Python regression tests"
"$PYTHON_BIN" -m unittest discover -s scripts/tests -p 'test_*.py'

if [[ "$RELEASE_CHECK" -eq 1 ]]; then
  echo "==> Release source hygiene"
  [[ -z "$(git status --short)" ]] || { git status --short >&2; echo "precheck: release source is dirty" >&2; exit 2; }
  for path in bin stage tmp docs/internal docs/reports docs/scripts grammars scripts/agents scripts/config scripts/models; do
    [[ ! -e "$path" ]] || { echo "precheck: obsolete or generated path remains: $path" >&2; exit 2; }
  done
  [[ -f pyproject.toml && -f uv.lock ]] || { echo "precheck: package metadata or lockfile is missing" >&2; exit 2; }
  embedded_pattern='python([0-9]+)?[[:space:]]*<'
  embedded_pattern+='<'
  if rg -n "$embedded_pattern" scripts --glob '*.sh' >/dev/null; then
    echo "precheck: embedded Python heredoc found in shell source" >&2
    exit 2
  fi
fi

echo "precheck: OK"
