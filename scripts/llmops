#!/usr/bin/env bash
set -euo pipefail

LLMOPS_HOME="${LLMOPS_HOME:-$HOME/.local/llm-ops}"
LLMOPS_BIN_DIR="${LLMOPS_BIN_DIR:-$LLMOPS_HOME/bin}"
if [[ -z "${LLMOPS_CONFIG_HOME:-}" && -f "$LLMOPS_HOME/current/config/config.json" ]]; then
  export LLMOPS_CONFIG_HOME="$LLMOPS_HOME/current/config"
fi

usage() {
  cat <<'USAGE'
Usage: llmops <command> [args...]

Commands:
  component
  config
  deploy
  doctor
  drift
  init
  migrate-config
  plan
  rollback
  stack

Run `llmops <command> --help` for command-specific help.
USAGE
}

cmd="${1:-}"
case "$cmd" in
  ""|-h|--help|help)
    usage
    exit 0
    ;;
esac

case "$cmd" in
  component|config|doctor|init|migrate-config|plan|stack)
    shift
    exec "$LLMOPS_BIN_DIR/llmops-control" "$cmd" "$@"
    ;;
  deploy|drift|rollback)
    shift
    exec "${LLMOPS_PYTHON_BIN:-python3}" "$LLMOPS_HOME/current/scripts/lib/llmops_deployment.py" "$cmd" "$@"
    ;;
esac
echo "llmops: unknown command: $cmd" >&2
echo "Run 'llmops --help' for available commands." >&2
exit 2
