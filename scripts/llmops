#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${LLMOPS_PYTHON_BIN:-python}"

command -v "$PYTHON_BIN" >/dev/null 2>&1 || {
  echo "llmops: application Python is unavailable; run the installer repair command" >&2
  exit 2
}

export PYTHONPATH="$SCRIPT_DIR/../src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON_BIN" -m llmops_kit.entrypoint "$@"
